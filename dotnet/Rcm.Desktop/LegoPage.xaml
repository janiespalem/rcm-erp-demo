<UserControl x:Class="Rcm.Desktop.LegoPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Rcm.Desktop">
  <Grid Margin="{StaticResource PageMargin}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,14"><TextBlock Text="Kalkulator bloczków LEGO" Style="{StaticResource Title}"/><TextBlock Text="Ceny netto według katalogu betoniarni." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Padding="14"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
        <TextBlock Text="Seria" Style="{StaticResource Label}"/><ComboBox x:Name="LegoSeries" ItemsSource="{Binding Series}" SelectedValuePath="Key" DisplayMemberPath="Name" SelectedValue="{Binding SeriesKey}" IsEnabled="{Binding CanEdit}" Margin="0,6,0,14"/>
        <TextBlock Text="Kształt" Style="{StaticResource Label}"/><ComboBox x:Name="LegoShape" ItemsSource="{x:Static local:LegoViewModel.Shapes}" SelectedValuePath="Key" DisplayMemberPath="Name" SelectedValue="{Binding Shape}" IsEnabled="{Binding CanEdit}" Margin="0,6,0,14"/>
        <StackPanel IsEnabled="{Binding CanEdit}">
          <TextBlock Text="{Binding LabelA}" Style="{StaticResource Label}"/><TextBox x:Name="LegoDimensionA" Text="{Binding DimensionA, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,14"/>
          <StackPanel Visibility="{Binding HasDimensionB, Converter={StaticResource Visible}}"><TextBlock Text="{Binding LabelB}" Style="{StaticResource Label}"/><TextBox Text="{Binding DimensionB, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,14"/></StackPanel>
          <StackPanel Visibility="{Binding HasDimensionC, Converter={StaticResource Visible}}"><TextBlock Text="Prawa (m)" Style="{StaticResource Label}"/><TextBox Text="{Binding DimensionC, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,14"/></StackPanel>
          <TextBlock Text="Wysokość (m)" Style="{StaticResource Label}"/><TextBox Text="{Binding Height, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,14"/>
          <StackPanel Visibility="{Binding IsBoxes, Converter={StaticResource Visible}}"><TextBlock Text="Liczba boksów (1–50)" Style="{StaticResource Label}"/><TextBox Text="{Binding Boxes, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,14"/></StackPanel>
          <StackPanel Visibility="{Binding HasArchOption, Converter={StaticResource Visible}}"><CheckBox Content="Dach łukowy LEGO" IsChecked="{Binding WithArch}" Margin="0,0,0,14"/><StackPanel Visibility="{Binding WithArch, Converter={StaticResource Visible}}"><TextBlock Text="Cena łuku / szt. (PLN netto)" Style="{StaticResource Label}"/><TextBox Text="{Binding ArchPrice, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,14"/></StackPanel></StackPanel>
        </StackPanel>
        <Button x:Name="CalculateLego" Content="Oblicz układ" Click="Calculate_Click" IsEnabled="{Binding CanCalculate}" Style="{StaticResource PrimaryButton}" Margin="0,8,0,10"/><Button Content="Zatrzymaj oczekiwanie" Click="Stop_Click" IsEnabled="{Binding IsWorking}" Margin="0,0,0,10"/>
        <Button x:Name="AddLegoResult" Content="Dodaj wynik do koszyka" Click="AddResult_Click" IsEnabled="{Binding CanAddResult}" Margin="0,0,0,12"/><TextBlock Text="{Binding Warnings}" Foreground="#A25A13" TextWrapping="Wrap"/>
      </StackPanel></ScrollViewer></Border>
      <TabControl x:Name="LegoTabs" Grid.Column="2">
        <TabItem Header="Układ 3D"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,14"/><local:LegoViewport x:Name="LegoScene" Grid.Row="1" MinHeight="180"/><DockPanel Grid.Row="2" Margin="0,12,0,0"><Button DockPanel.Dock="Right" Content="Dopasuj widok" Click="ResetView_Click"/><TextBlock Text="LPM: obracaj · kółko: zoom. Dach poglądowy; liczba łuków według wyniku." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,12,0" VerticalAlignment="Center"/></DockPanel></Grid></TabItem>
        <TabItem Header="Plan 2D"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><DockPanel Margin="0,0,0,12"><TextBlock Text="Warstwa" VerticalAlignment="Center" Margin="0,0,12,0"/><ComboBox x:Name="LegoLayer" Width="100" SelectionChanged="Layer_Changed"/></DockPanel><local:LegoPlanView x:Name="LegoTopPlan" Grid.Row="1" Plan="{Binding Result}"/></Grid></TabItem>
        <TabItem Header="Warstwy / narożniki"><DataGrid ItemsSource="{Binding Courses}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserSortColumns="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.HorizontalScrollBarVisibility="Auto"><DataGrid.Columns><DataGridTextColumn Header="Ściana" Binding="{Binding Wall}" Width="130"/><DataGridTextColumn Header="Warstwa" Binding="{Binding Row}" Width="85"/><DataGridTextColumn Header="Przesunięcie" Binding="{Binding Offset}" Width="110"/><DataGridTextColumn Header="Długość" Binding="{Binding Length}" Width="95"/><DataGridTextColumn Header="Bloczki" Binding="{Binding Sequence}" Width="*" MinWidth="220" ElementStyle="{StaticResource CellText}"/><DataGridTextColumn Header="Uwaga" Binding="{Binding Warning}" Width="150" ElementStyle="{StaticResource CellText}"/></DataGrid.Columns></DataGrid></TabItem>
        <TabItem Header="Zestawienie"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,14"/><DataGrid Grid.Row="1" ItemsSource="{Binding Counts}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" EnableRowVirtualization="True"><DataGrid.Columns><DataGridTextColumn Header="Bloczek" Binding="{Binding Length}" Width="*"/><DataGridTextColumn Header="Ilość" Binding="{Binding Quantity}" Width="85"/><DataGridTextColumn Header="Masa" Binding="{Binding Weight}" Width="110"/><DataGridTextColumn Header="Cena / szt." Binding="{Binding UnitPrice}" Width="110"/><DataGridTextColumn Header="Wartość" Binding="{Binding Total}" Width="130"/></DataGrid.Columns></DataGrid></Grid></TabItem>
        <TabItem Header="Lokalny koszyk" ToolTip="Koszyk na tym komputerze, osobno dla Twojego konta. Ceny i masa pozycji pozostają zapisanym zestawieniem."><Grid Margin="12"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer x:Name="LegoCartBody" VerticalScrollBarVisibility="Auto"><StackPanel>
          <DockPanel Margin="0,0,0,8"><Button x:Name="AddLegoProduct" DockPanel.Dock="Right" VerticalAlignment="Center" Content="Dodaj prefabrykat" Click="AddProduct_Click" IsEnabled="{Binding CanAddProduct}" Margin="12,0,0,0"/><ComboBox x:Name="LegoProducts" Margin="0" ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}" DisplayMemberPath="Name" IsEnabled="{Binding CanCartEdit}"/></DockPanel>
          <DataGrid x:Name="LegoCart" Height="180" ItemsSource="{Binding Cart}" SelectedItem="{Binding SelectedCartRow}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="False" EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling" IsEnabled="{Binding CanCartEdit}" ScrollViewer.HorizontalScrollBarVisibility="Auto"><DataGrid.Columns><DataGridTextColumn Header="Pozycja" Binding="{Binding Name}" Width="*" MinWidth="180" IsReadOnly="True" ElementStyle="{StaticResource CellText}"/><DataGridTextColumn Header="Ilość" Binding="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}" Width="80"/><DataGridTextColumn Header="Masa" Binding="{Binding Weight}" Width="100" IsReadOnly="True"/><DataGridTextColumn Header="Wartość netto" Binding="{Binding Net}" Width="145" IsReadOnly="True" ElementStyle="{StaticResource CellText}"/><DataGridTextColumn Header="Dane / uwagi" Binding="{Binding Details}" Width="*" MinWidth="220" IsReadOnly="True" ElementStyle="{StaticResource CellText}"/></DataGrid.Columns><DataGrid.RowDetailsTemplate><DataTemplate><StackPanel Margin="12"><TextBlock Text="{Binding Warning}" Foreground="#A25A13" TextWrapping="Wrap"/><TextBlock Text="{Binding Error}" Foreground="{StaticResource Error}" TextWrapping="Wrap"/></StackPanel></DataTemplate></DataGrid.RowDetailsTemplate></DataGrid>
          <StackPanel Margin="0,14,0,0"><TextBlock Text="{Binding CartSummary}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding CartStatus}" TextWrapping="Wrap" Margin="0,8,0,12" AutomationProperties.LiveSetting="Polite"/></StackPanel>
          <WrapPanel><Button Content="Usuń pozycję" Click="Remove_Click" IsEnabled="{Binding CanRemove}" Margin="0,0,10,8"/><Button Content="Wyczyść koszyk" Click="ClearCart_Click" IsEnabled="{Binding CanClear}" Margin="0,0,10,8"/></WrapPanel></StackPanel></ScrollViewer><WrapPanel Grid.Row="1" Margin="0,10,0,0"><Button x:Name="SaveLegoCart" Content="Zapisz koszyk lokalnie" Click="SaveCart_Click" IsEnabled="{Binding CanSaveCart}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,8"/><Button Content="Ponów wczytanie" Click="LoadCart_Click" Margin="0,0,0,8"/></WrapPanel>
        </Grid></TabItem>
      </TabControl>
    </Grid>
    <TextBlock Grid.Row="2" Text="{Binding Status}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite"/>
  </Grid>
</UserControl>
