<UserControl x:Class="Rcm.Desktop.TemplateWorkspace" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="{StaticResource PageMargin}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,20"><Button DockPanel.Dock="Right" Content="+ Nowy szablon SOP" Click="Create_Click" Style="{StaticResource PrimaryButton}" Visibility="{Binding IsAdmin, Converter={StaticResource Visible}}" IsEnabled="{Binding CanCreate}" Margin="16,0,0,0"/><StackPanel><TextBlock Text="{Binding Heading}" Style="{StaticResource Title}"/></StackPanel></DockPanel>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Grid Width="240" Visibility="{Binding IsProjects, Converter={StaticResource Visible}}" Margin="0,0,18,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBox Text="{Binding ProjectSearch, UpdateSourceTrigger=PropertyChanged}" TextChanged="ProjectSearch_Changed" ToolTip="Szukaj projektu" Margin="0,0,0,12"/>
        <DataGrid x:Name="TemplateProjects" Grid.Row="1" ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" SelectionChanged="Project_Changed" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserSortColumns="True" EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling" SelectionMode="Single" SelectionUnit="FullRow" MinRowHeight="42"><DataGrid.Columns><DataGridTextColumn Header="Projekt" Binding="{Binding Code}" Width="*" ElementStyle="{StaticResource CellText}"/><DataGridTextColumn Header="Poz." Binding="{Binding PositionsCount}" Width="55"/></DataGrid.Columns></DataGrid>
        <StackPanel Grid.Row="2" Margin="0,12,0,0"><TextBlock Text="{Binding ProjectInfo}" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/><WrapPanel Margin="0,8,0,0"><Button Content="←" Click="ProjectsPrevious_Click" IsEnabled="{Binding CanProjectPrevious}" Margin="0,0,8,0"/><Button Content="→" Click="ProjectsNext_Click" IsEnabled="{Binding CanProjectNext}"/></WrapPanel></StackPanel>
      </Grid>
      <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Visibility="{Binding IsProjects, Converter={StaticResource Visible}}" Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="Arkusze całego projektu PDF…" Click="ProjectDocument_Click" IsEnabled="{Binding CanDownloadProject}" Margin="12,0,0,0"/><TextBlock Text="{Binding ProjectHeading}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
        <Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="160"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBox x:Name="TemplateSearch" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" TextChanged="Search_Changed" ToolTip="Szukaj nazwy lub numeru pozycji"/>
          <TextBox Grid.Column="2" Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}" TextChanged="Search_Changed" ToolTip="Kategoria — pozostaw puste dla wszystkich"/>
          <CheckBox Grid.Column="3" Content="Archiwum" IsChecked="{Binding IncludeArchived}" Checked="Archive_Changed" Unchecked="Archive_Changed" Visibility="{Binding IsAdmin, Converter={StaticResource Visible}}" VerticalAlignment="Center" Margin="14,0,0,0"/>
        </Grid>
        <Border Grid.Row="2" Style="{StaticResource Card}"><DataGrid x:Name="TemplateRows" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserSortColumns="True" SelectionMode="Single" SelectionUnit="FullRow" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling" MinRowHeight="44" MouseDoubleClick="Open_Click" KeyDown="Rows_KeyDown" ScrollViewer.HorizontalScrollBarVisibility="Auto">
          <DataGrid.Columns><DataGridTextColumn Header="Projekt / grupa" Binding="{Binding Group}" Width="150" ElementStyle="{StaticResource CellText}"/><DataGridTextColumn Header="Poz." Binding="{Binding Position}" Width="80"/><DataGridTextColumn Header="Nazwa" Binding="{Binding Name}" Width="2*" MinWidth="180" ElementStyle="{StaticResource CellText}"/><DataGridTextColumn Header="Kategoria" Binding="{Binding Category}" Width="130" ElementStyle="{StaticResource CellText}"/><DataGridTextColumn Header="Cena / status" Binding="{Binding Price}" Width="130" ElementStyle="{StaticResource CellText}"/><DataGridTextColumn Header="Stan" Binding="{Binding State}" Width="100"/></DataGrid.Columns>
        </DataGrid></Border>
        <DockPanel Grid.Row="3" Margin="0,12,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Poprzednia" Click="Previous_Click" IsEnabled="{Binding CanPrevious}" Margin="0,0,8,0"/><Button Content="Następna" Click="Next_Click" IsEnabled="{Binding CanNext}"/></StackPanel><Button Content="Otwórz szablon" Click="Open_Click" IsEnabled="{Binding CanOpen}" Margin="0,0,16,0" DockPanel.Dock="Left"/><TextBlock Text="{Binding PageInfo}" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></DockPanel>
      </Grid>
    </Grid>
    <StackPanel Grid.Row="2" Margin="0,14,0,0"><TextBlock Text="{Binding AccessHint}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"/><DockPanel><Button DockPanel.Dock="Right" Content="Odśwież" Click="Refresh_Click" Margin="12,0,0,0"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/></DockPanel></StackPanel>
  </Grid>
</UserControl>
