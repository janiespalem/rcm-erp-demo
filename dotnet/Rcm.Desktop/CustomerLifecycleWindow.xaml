<Window x:Class="Rcm.Desktop.CustomerLifecycleWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource WindowStyle}" Width="600" Height="570" MinWidth="440" MinHeight="420" WindowStartupLocation="CenterOwner">
  <Grid Margin="26">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock x:Name="Heading" Style="{StaticResource Title}" FontSize="25" Margin="0,0,0,18"/>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <TextBlock x:Name="Explanation" TextWrapping="Wrap" LineHeight="22" Margin="0,0,0,18"/>
        <Border Style="{StaticResource Card}" Padding="18"><TextBlock Text="{Binding CustomerSummary}" TextWrapping="Wrap"/></Border>
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,18,0,10" AutomationProperties.LiveSetting="Polite"/>
        <StackPanel Visibility="{Binding HasConflict, Converter={StaticResource Visible}}">
          <Button Content="Pokaż aktualnie zapisane dane" Click="Compare_Click" HorizontalAlignment="Left"/>
          <TextBlock Text="{Binding Comparison}" TextWrapping="Wrap" Margin="0,12"/>
          <Button Content="Użyj porównanej wersji" IsEnabled="{Binding CanAcceptComparison}" Click="Accept_Click" HorizontalAlignment="Left"/>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
    <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button Content="Anuluj" Click="Cancel_Click" Margin="0,0,10,8"/>
      <Button x:Name="Confirm" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding CanSave}" Click="Save_Click" Margin="0,0,0,8" AutomationProperties.AutomationId="ConfirmCustomerLifecycle"/>
    </WrapPanel>
  </Grid>
</Window>
