<UserControl x:Class="Rcm.Desktop.InsightsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="{StaticResource PageMargin}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,12">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="ExportInsights" Visibility="{Binding ExportAllowed, Converter={StaticResource Visible}}" Content="Zapisz XLSX…" Click="Export_Click" IsEnabled="{Binding CanExport}" Margin="8,0,0,0"/><Button Content="Anuluj zapis" Click="CancelExport_Click" Visibility="{Binding Exporting, Converter={StaticResource Visible}}" Margin="8,0,0,0"/></StackPanel>
      <ComboBox x:Name="ReportSelector" DockPanel.Dock="Right" Width="250" Margin="12,0" VerticalAlignment="Center" ItemsSource="{Binding Choices}" DisplayMemberPath="Title" SelectedValuePath="Section" SelectedValue="{Binding Section}" SelectionChanged="Report_Changed" AutomationProperties.AutomationId="ReportSelector"/>
      <TextBlock Text="{Binding Title}" Style="{StaticResource Title}" VerticalAlignment="Center"/>
    </DockPanel>
    <DockPanel Grid.Row="1" Margin="0,0,0,10">
      <Button DockPanel.Dock="Right" Content="Odśwież" Click="Refresh_Click" MinWidth="105" Margin="8,0,0,0"/>
      <TextBox x:Name="ReportSearch" MaxLength="200" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" TextChanged="Search_Changed" Visibility="{Binding SearchVisible, Converter={StaticResource Visible}}" AutomationProperties.Name="Szukaj dosłownego tekstu" ToolTip="Szukaj klienta, numeru lub opisu. Znaki % i _ są dosłowne."/>
      <WrapPanel Visibility="{Binding BenchmarkVisible, Converter={StaticResource Visible}}">
        <StackPanel Margin="0,0,12,0"><TextBlock Text="Materiał" Foreground="{StaticResource Muted}"/><TextBox Width="220" MaxLength="200" Text="{Binding Material, UpdateSourceTrigger=PropertyChanged}" TextChanged="Search_Changed" AutomationProperties.Name="Materiał do porównania"/></StackPanel>
        <StackPanel><TextBlock Text="Typ zlecenia" Foreground="{StaticResource Muted}"/><TextBox Width="220" MaxLength="200" Text="{Binding OrderType, UpdateSourceTrigger=PropertyChanged}" TextChanged="Search_Changed" AutomationProperties.Name="Typ zlecenia do porównania"/></StackPanel>
      </WrapPanel>
    </DockPanel>
    <ScrollViewer Grid.Row="2" MaxHeight="104" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding Metrics}" Margin="0,0,0,10">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,8,8" MinWidth="155"><StackPanel><TextBlock Text="{Binding Title}" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Value}" FontSize="21" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl></ScrollViewer>
    <Expander x:Name="RevenueDetails" Grid.Row="3" Header="Przychód i najważniejsi klienci" IsExpanded="True" Visibility="{Binding AnalyticsVisible, Converter={StaticResource Visible}}" Margin="0,0,0,12"><Grid Height="150">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Padding="12"><DockPanel><TextBlock DockPanel.Dock="Top" Text="Przychód netto · ostatnie 183 dni" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/><DataGrid ItemsSource="{Binding Revenue}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserSortColumns="True" HeadersVisibility="Column"><DataGrid.Columns><DataGridTextColumn Header="Miesiąc" Binding="{Binding Month}" Width="*"/><DataGridTextColumn Header="Zlecenia" Binding="{Binding Orders}" Width="90"/><DataGridTextColumn Header="Netto zł" Binding="{Binding RevenuePln, StringFormat={}{0:N2}, ConverterCulture=pl-PL}" Width="130"/></DataGrid.Columns></DataGrid></DockPanel></Border>
      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12"><DockPanel><TextBlock DockPanel.Dock="Top" Text="Klienci · najwyższy przychód" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/><DataGrid ItemsSource="{Binding Clients}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserSortColumns="True" HeadersVisibility="Column"><DataGrid.Columns><DataGridTextColumn Header="Klient" Binding="{Binding Client}" Width="*"/><DataGridTextColumn Header="Zlecenia" Binding="{Binding Orders}" Width="90"/><DataGridTextColumn Header="Netto zł" Binding="{Binding RevenuePln, StringFormat={}{0:N2}, ConverterCulture=pl-PL}" Width="130"/></DataGrid.Columns></DataGrid></DockPanel></Border>
    </Grid></Expander>
    <DataGrid x:Name="InsightList" Grid.Row="4" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="True" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling" HeadersVisibility="Column" SelectionMode="Single" AutomationProperties.AutomationId="InsightList"/>
    <StackPanel Grid.Row="5" Margin="0,10,0,0"><TextBlock Text="{Binding Scope}" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/><DockPanel Margin="0,8,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><TextBlock Text="{Binding PageInfo}" VerticalAlignment="Center" Margin="0,0,12,0"/><Button Content="Poprzednia" Click="Previous_Click" IsEnabled="{Binding CanPrevious}" Margin="0,0,6,0"/><Button x:Name="NextInsights" Content="Następna" Click="Next_Click" IsEnabled="{Binding CanNext}"/></StackPanel><TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/></DockPanel></StackPanel>
  </Grid>
</UserControl>
