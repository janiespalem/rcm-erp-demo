<UserControl x:Class="Rcm.Desktop.OrderQuestionQueuePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="0,6,0,0">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,16">
      <StackPanel DockPanel.Dock="Right" Width="215" Margin="16,0,0,0"><TextBlock Text="Stan pytania" Foreground="{StaticResource Muted}" Margin="0,0,0,5"/><ComboBox x:Name="QuestionStatus" SelectedValuePath="Key" DisplayMemberPath="Value" SelectedValue="{Binding Filter}" SelectionChanged="Filter_Changed"/></StackPanel>
      <StackPanel><TextBlock Text="Szukaj pytania, odpowiedzi, klienta lub numeru zlecenia" Foreground="{StaticResource Muted}" Margin="0,0,0,5"/><TextBox x:Name="QuestionSearch" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" TextChanged="Search_Changed"/></StackPanel>
    </DockPanel>
    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
      <DataGrid x:Name="QuestionList" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Auto" KeyDown="Questions_KeyDown">
        <DataGrid.Columns>
          <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Zlecenie" Binding="{Binding Number}" Width="105" MinWidth="80"/>
          <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Klient" Binding="{Binding Client}" Width="1*" MinWidth="120"/>
          <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Pytanie" Binding="{Binding QuestionText}" Width="2*" MinWidth="160"/>
          <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Odpowiedź" Binding="{Binding AnswerText}" Width="1.5*" MinWidth="120"/>
          <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Termin" Binding="{Binding DeadlineHint}" Width="145" MinWidth="100"/>
          <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Stan" Binding="{Binding Status}" Width="155"/>
          <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Zadano" Binding="{Binding AskedAt}" Width="140" MinWidth="140"/>
          <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Archiwum" Binding="{Binding Archive}" Width="145"/>
        </DataGrid.Columns>
      </DataGrid>
    </Border>
    <StackPanel Grid.Row="2" Margin="0,12,0,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Poprzednia" Click="Previous_Click" IsEnabled="{Binding CanPrevious}" Margin="0,0,8,0"/><Button Content="Następna" Click="Next_Click" IsEnabled="{Binding CanNext}" Margin="0,0,8,0"/><Button Content="Odśwież" Click="Refresh_Click"/></StackPanel>
        <Button x:Name="OpenQuestion" Content="Otwórz pytanie / odpowiedz" Click="Open_Click" IsEnabled="{Binding CanOpen}" DockPanel.Dock="Left" Margin="0,0,16,0" AutomationProperties.AutomationId="OpenOrderQuestion"/>
        <TextBlock Text="{Binding PageInfo}" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
      </DockPanel>
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite"/>
    </StackPanel>
  </Grid>
</UserControl>
