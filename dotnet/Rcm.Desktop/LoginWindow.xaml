<Window x:Class="Rcm.Desktop.LoginWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource WindowStyle}" Title="FactoryFlow — logowanie" Width="520" Height="560" MinWidth="420" MinHeight="420" WindowStartupLocation="CenterScreen" ResizeMode="CanResize">
  <ScrollViewer Background="{StaticResource Paper}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Border Style="{StaticResource Card}" MaxWidth="380" Padding="32" Margin="18" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel>
        <TextBlock Text="FactoryFlow" FontSize="38" FontWeight="Bold" Foreground="{StaticResource Green}" Margin="0,0,0,30"/>
        <TextBlock Text="Użytkownik" Style="{StaticResource Label}"/>
        <TextBox x:Name="Username" MaxLength="100" AutomationProperties.AutomationId="LoginUsername" AutomationProperties.Name="Użytkownik"/>
        <TextBlock Text="Hasło" Style="{StaticResource Label}"/>
        <PasswordBox x:Name="Password" MaxLength="256" Margin="0,6,0,14" AutomationProperties.AutomationId="LoginPassword" AutomationProperties.Name="Hasło"/>
        <CheckBox x:Name="Remember" Content="Zapamiętaj mnie" Margin="0,0,0,22" AutomationProperties.AutomationId="LoginRemember"/>
        <Button x:Name="Submit" Content="Zaloguj się" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Login_Click" AutomationProperties.AutomationId="LoginSubmit"/>
        <TextBlock x:Name="Status" TextWrapping="Wrap" Margin="0,16,0,0" Foreground="{StaticResource Error}" AutomationProperties.LiveSetting="Polite"/>
        <TextBlock x:Name="StartupNotice" Visibility="Collapsed" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite"/>
      </StackPanel>
    </Border>
  </ScrollViewer>
</Window>
