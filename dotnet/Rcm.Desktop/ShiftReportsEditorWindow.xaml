<Window x:Class="Rcm.Desktop.ShiftReportsEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Rcm.Desktop"
        Style="{StaticResource WindowStyle}" Title="Raport zmiany" Width="1040" Height="850" MinWidth="780" MinHeight="520" WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <DataTemplate x:Key="ShiftField"><StackPanel Margin="0,0,16,14"><TextBlock Text="{Binding Label}" Style="{StaticResource Label}" TextWrapping="Wrap"/><TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" MaxLength="{Binding Limit}" AcceptsReturn="{Binding Multiline}" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="40" MaxHeight="130" Margin="0,6,0,0" IsReadOnly="{Binding DataContext.ReadOnly, RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.Name="{Binding Label}"/><TextBlock Text="{Binding Error}" Foreground="{StaticResource Error}" TextWrapping="Wrap"/></StackPanel></DataTemplate>
    <DataTemplate x:Key="ShiftChanges"><DataGrid ItemsSource="{Binding}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="240" EnableRowVirtualization="True"><DataGrid.Columns><DataGridTextColumn Header="Pole" Binding="{Binding Label}" Width="1.2*" ElementStyle="{StaticResource CellText}"/><DataGridTextColumn Header="Przed / na serwerze" Binding="{Binding Before}" Width="*" ElementStyle="{StaticResource CellText}"/><DataGridTextColumn Header="Po / Twój formularz" Binding="{Binding After}" Width="*" ElementStyle="{StaticResource CellText}"/></DataGrid.Columns></DataGrid></DataTemplate>
  </Window.Resources>
  <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="{Binding Heading}" Style="{StaticResource Title}" TextWrapping="Wrap"/><TextBlock Text="{Binding Description}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/><TextBlock Text="{Binding AccessHint}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,12"/>
      <Border x:Name="ReportContractSummary" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12" Visibility="{Binding Production.Available, Converter={StaticResource Visible}}">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,16,0"><TextBlock Text="Kontrakt" Style="{StaticResource Label}"/><TextBlock x:Name="ReportContractName" Text="{Binding Production.CurrentContract}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Production.CurrentContract}" Margin="0,4,0,0"/><TextBlock x:Name="ReportReviewState" Text="{Binding Production.StateLabel}" Foreground="{StaticResource Muted}" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite"/></StackPanel>
          <Button x:Name="OpenReportContract" Grid.Column="1" Content="Kontrakt / sprawdzenie" Click="OpenProduction_Click" IsEnabled="{Binding Production.CanRead}" VerticalAlignment="Center"/>
        </Grid>
      </Border>
    </StackPanel>
    <WrapPanel Grid.Row="1" Visibility="{Binding IsNew, Converter={StaticResource Visible}}" Margin="0,0,0,12"><DatePicker SelectedDate="{Binding ReportDate}" IsEnabled="{Binding CanCreate}" Width="160" Margin="0,0,12,0"/><ComboBox SelectedItem="{Binding Shift}" IsEnabled="{Binding CanCreate}" Width="90" Margin="0,0,12,0"><ComboBox.ItemsSource><x:Static Member="local:ShiftReportsChoices.Shifts"/></ComboBox.ItemsSource></ComboBox><Button x:Name="CreateShiftReport" Content="Otwórz / utwórz raport" Click="Create_Click" IsEnabled="{Binding CanCreate}"/></WrapPanel>
    <TabControl x:Name="ShiftReportTabs" Grid.Row="2">
      <TabItem x:Name="ReportFormTab" Header="Formularz"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18">
        <ItemsControl ItemsSource="{Binding HeaderFields}" ItemTemplate="{StaticResource ShiftField}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
        <TextBlock Text="1. Ilości" Style="{StaticResource SectionTitle}" Margin="0,12,0,14"/><ItemsControl ItemsSource="{Binding Quantities}" ItemTemplate="{StaticResource ShiftField}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
        <TextBlock Text="2. Sprzęt na produkcji" Style="{StaticResource SectionTitle}" Margin="0,14,0,14"/>
        <ItemsControl ItemsSource="{Binding Equipment}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,18"><TextBlock Text="{Binding Label}" FontWeight="SemiBold"/><Grid Margin="0,8,0,0" IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=Window}}"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><ComboBox ItemsSource="{x:Static local:ShiftReportsEquipment.Conditions}" SelectedItem="{Binding Condition}" Margin="0,0,12,0" AutomationProperties.Name="Stan sprzętu"/><StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="Powód / osoba odpowiedzialna" Style="{StaticResource Label}"/><TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" MaxLength="1000" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Uwaga / nr" Style="{StaticResource Label}"/><TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" MaxLength="1000" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Grid><TextBlock Text="{Binding Error}" Foreground="{StaticResource Error}" TextWrapping="Wrap"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <TextBlock Text="3. Kontrola końcowa" Style="{StaticResource SectionTitle}" Margin="0,14,0,14"/>
        <ItemsControl x:Name="ShiftReportChecks" ItemsSource="{Binding Checks}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,18,0"><TextBlock Text="{Binding Label}" TextWrapping="Wrap" VerticalAlignment="Center"/><TextBlock Text="{Binding Error}" Foreground="{StaticResource Error}" TextWrapping="Wrap"/></StackPanel><ComboBox Grid.Column="1" ItemsSource="{x:Static local:ShiftReportsCheck.Answers}" SelectedItem="{Binding Answer}" IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.Name="{Binding Label}"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <TextBlock Text="4. Uwagi i niezgodności" Style="{StaticResource SectionTitle}" Margin="0,24,0,14"/><ItemsControl ItemsSource="{Binding Notes}" ItemTemplate="{StaticResource ShiftField}"/>
        <TextBlock Text="Zatwierdzenie" Style="{StaticResource SectionTitle}" Margin="0,14,0,14"/><ItemsControl ItemsSource="{Binding Signatures}" ItemTemplate="{StaticResource ShiftField}"/>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="Korekta / usunięcie"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18">
        <Button x:Name="StartShiftCorrection" Content="Rozpocznij korektę" Click="StartCorrection_Click" IsEnabled="{Binding CanStartCorrection}" HorizontalAlignment="Left"/>
        <StackPanel Visibility="{Binding Correction, Converter={StaticResource Visible}}" Margin="0,16,0,0"><TextBlock Text="Powód korekty *" Style="{StaticResource Label}"/><TextBox x:Name="ShiftCorrectionReason" Text="{Binding CorrectionReason, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding ReadOnly}" MaxLength="2000" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" Margin="0,6,0,12"/><Button Content="Odrzuć korektę" Click="CancelCorrection_Click" HorizontalAlignment="Left"/></StackPanel>
        <TextBlock Text="Powód administracyjnego usunięcia *" Style="{StaticResource Label}" Margin="0,32,0,6"/><TextBox x:Name="ShiftDeleteReason" Text="{Binding DeleteReason, UpdateSourceTrigger=PropertyChanged}" MaxLength="2000" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" IsEnabled="{Binding CanAdminDelete}"/>
        <TextBlock Text="Usunięty raport pozostaje w audycie i przestaje być uwzględniany w podsumowaniu." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,14"/>
        <Button x:Name="AdminDeleteShiftReport" Content="Usuń administracyjnie" Click="AdminDelete_Click" IsEnabled="{Binding CanAdminDelete}" HorizontalAlignment="Left"/><Button x:Name="DiscardShiftReport" Content="Usuń niedokończony własny szkic" Click="Discard_Click" IsEnabled="{Binding CanDiscard}" HorizontalAlignment="Left" Margin="0,20,0,0"/>
        <TextBlock Text="{Binding ReasonError}" Foreground="{StaticResource Error}" TextWrapping="Wrap" Margin="0,12,0,0"/>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="Porównanie"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18"><ContentControl Content="{Binding Comparison}" ContentTemplate="{StaticResource ShiftChanges}"/><WrapPanel Margin="0,16,0,0"><Button Content="Pobierz aktualną wersję" Click="Compare_Click" IsEnabled="{Binding CanCompare}" Margin="0,0,12,0"/><Button Content="Porównano — zachowaj moje wartości" Click="Accept_Click" IsEnabled="{Binding CanAccept}"/></WrapPanel></StackPanel></ScrollViewer></TabItem>
      <TabItem Header="Historia zmian"><Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><WrapPanel Margin="0,0,0,14"><CheckBox Content="Pokaż zapisy szkiców" IsChecked="{Binding IncludeDrafts}" Checked="AuditFilter_Click" Unchecked="AuditFilter_Click" VerticalAlignment="Center" Margin="0,0,16,0"/><Button Content="Wczytaj historię" Click="Audit_Click" IsEnabled="{Binding CanReadAudit}"/></WrapPanel><ListBox Grid.Row="1" ItemsSource="{Binding Audit}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="0,8,0,16"><TextBlock Text="{Binding Heading}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Reason}" TextWrapping="Wrap" Margin="0,8,0,8"/><ContentControl Content="{Binding Changes}" ContentTemplate="{StaticResource ShiftChanges}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></TabItem>
      <TabItem Header="Wydruk"><DockPanel Margin="14"><WrapPanel DockPanel.Dock="Top" Margin="0,0,0,14"><Button Content="Przygotuj podgląd A4" Click="PreviewPrint_Click" IsEnabled="{Binding CanPrint}" Margin="0,0,12,0"/><Button Content="Drukuj A4…" Click="Print_Click" IsEnabled="{Binding CanPrint}"/></WrapPanel><FlowDocumentScrollViewer x:Name="ShiftPrintPreview" IsToolBarVisible="False"/></DockPanel></TabItem>
      <TabItem x:Name="ReportProductionTab" Header="Kontrakt / sprawdzenie"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18">
        <WrapPanel Margin="0,0,0,12"><Button x:Name="ReturnToReportForm" Content="Wróć do formularza" Click="OpenForm_Click" Margin="0,0,12,0"/><Button Content="Wczytaj aktualny stan" Click="ProductionRefresh_Click" IsEnabled="{Binding Production.CanRefresh}"/></WrapPanel>
        <StackPanel Visibility="{Binding Production.Available, Converter={StaticResource Visible}}">
          <TextBlock Text="Przypisany kontrakt" Style="{StaticResource Label}"/><TextBlock Text="{Binding Production.CurrentContract}" FontSize="19" FontWeight="SemiBold" Margin="0,5,0,5" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding Production.StateLabel}" FontWeight="SemiBold"/><TextBlock Text="{Binding Production.ReviewInfo}" TextWrapping="Wrap" Margin="0,5,0,12"/>
          <TextBlock Text="{Binding Production.LinkHint}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,12"/>
          <StackPanel Visibility="{Binding Production.Features.Link, Converter={StaticResource Visible}}">
            <DockPanel><Button Content="Szukaj" DockPanel.Dock="Right" Click="ProductionSearch_Click" IsEnabled="{Binding Production.CanChoose}" Margin="10,0,0,0"/><TextBox x:Name="ReportContractSearch" Text="{Binding Production.Query, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Production.CanChoose}" AutomationProperties.Name="Szukaj kontraktu"/></DockPanel>
            <ComboBox x:Name="ReportContractSelection" ItemsSource="{Binding Production.Contracts}" SelectedItem="{Binding Production.SelectedContract}" DisplayMemberPath="Name" IsEnabled="{Binding Production.CanChoose}" Margin="0,10,0,10" AutomationProperties.Name="Kontrakt raportu"/>
            <StackPanel Orientation="Horizontal"><Button Content="‹" Click="ProductionPreviousContract_Click" IsEnabled="{Binding Production.CanPreviousContract}"/><TextBlock Text="{Binding Production.ContractPageInfo}" VerticalAlignment="Center" Margin="10,0"/><Button Content="›" Click="ProductionNextContract_Click" IsEnabled="{Binding Production.CanNextContract}"/></StackPanel>
            <TextBlock Text="Powód zmiany kontraktu" Style="{StaticResource Label}" Margin="0,14,0,6"/><TextBox x:Name="ReportLinkReason" Text="{Binding Production.LinkReason, UpdateSourceTrigger=PropertyChanged}" MaxLength="2000" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="65" IsEnabled="{Binding Production.CanChoose}"/>
            <Button x:Name="LinkProductionReport" Content="Zapisz przypisanie kontraktu" Click="ProductionLink_Click" IsEnabled="{Binding Production.CanLink}" HorizontalAlignment="Left" Margin="0,12,0,20"/>
          </StackPanel>
          <StackPanel Visibility="{Binding Production.Features.Review, Converter={StaticResource Visible}}">
            <TextBlock Text="Powód zwrotu / uwagi sprawdzającego" Style="{StaticResource Label}"/><TextBox x:Name="ReportReviewReason" Text="{Binding Production.ReviewReason, UpdateSourceTrigger=PropertyChanged}" MaxLength="2000" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="75" IsEnabled="{Binding Production.CanReview}" Margin="0,6,0,12"/>
            <WrapPanel><Button x:Name="AcceptProductionReport" Content="Przyjmij raport" Style="{StaticResource PrimaryButton}" Click="ProductionAccept_Click" IsEnabled="{Binding Production.CanReview}" Margin="0,0,12,12"/><Button x:Name="ReturnProductionReport" Content="Zwróć do korekty" Click="ProductionReturn_Click" IsEnabled="{Binding Production.CanReview}" Margin="0,0,0,12"/></WrapPanel>
          </StackPanel>
          <TextBlock Text="{Binding Production.Status}" TextWrapping="Wrap" Margin="0,4,0,10" AutomationProperties.LiveSetting="Polite"/>
          <Button x:Name="RetryProductionReport" Content="Ponów tę samą operację" Click="ProductionRetry_Click" IsEnabled="{Binding Production.CanRetry}" Visibility="{Binding Production.Uncertain, Converter={StaticResource Visible}}" HorizontalAlignment="Left" Margin="0,0,0,12"/>
          <StackPanel Visibility="{Binding Production.HasConflict, Converter={StaticResource Visible}}"><Button Content="Pobierz wersję do porównania" Click="ProductionCompare_Click" IsEnabled="{Binding Production.CanCompare}" HorizontalAlignment="Left"/><TextBlock Text="{Binding Production.ComparisonInfo}" TextWrapping="Wrap" Margin="0,10"/><ContentControl Content="{Binding Comparison}" ContentTemplate="{StaticResource ShiftChanges}"/><Button x:Name="AcceptProductionComparison" Content="Porównano — zachowaj wybór i powód" Click="ProductionAcceptComparison_Click" IsEnabled="{Binding Production.CanAcceptComparison}" HorizontalAlignment="Left" Margin="0,12,0,12"/></StackPanel>
          <Button Content="Wczytaj historię przypisania i sprawdzenia" Click="ProductionAudit_Click" IsEnabled="{Binding Production.CanRead}" HorizontalAlignment="Left" Margin="0,16,0,12"/>
          <DataGrid ItemsSource="{Binding Production.Audit}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="230" EnableRowVirtualization="True"><DataGrid.Columns><DataGridTextColumn Header="Czas w Warszawie" Binding="{Binding Time}" Width="145"/><DataGridTextColumn Header="Autor ID" Binding="{Binding Actor}" Width="65"/><DataGridTextColumn Header="Operacja" Binding="{Binding Action}" Width="145"/><DataGridTextColumn Header="Powód" Binding="{Binding Reason}" Width="*" ElementStyle="{StaticResource CellText}"/><DataGridTextColumn Header="Zmiany" Binding="{Binding Changes}" Width="*" ElementStyle="{StaticResource CellText}"/></DataGrid.Columns></DataGrid>
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button Content="‹" Click="ProductionPreviousAudit_Click" IsEnabled="{Binding Production.CanPreviousAudit}"/><TextBlock Text="{Binding Production.AuditPageInfo}" VerticalAlignment="Center" Margin="10,0"/><Button Content="›" Click="ProductionNextAudit_Click" IsEnabled="{Binding Production.CanNextAudit}"/></StackPanel>
        </StackPanel>
      </StackPanel></ScrollViewer></TabItem>
    </TabControl>
    <StackPanel Grid.Row="3" Margin="0,12,0,12"><TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/><TextBlock Text="{Binding Errors.Count, StringFormat=Liczba błędów pól: {0}}" Foreground="{StaticResource Error}"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Errors.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel>
    <WrapPanel Grid.Row="4" HorizontalAlignment="Right"><Button Content="Zatrzymaj oczekiwanie" Click="Cancel_Click" Visibility="{Binding OperationBusy, Converter={StaticResource Visible}}" IsEnabled="{Binding OperationBusy}" Margin="0,0,10,8"/><Button x:Name="RetryShiftReport" Content="Ponów tę samą operację" Click="Retry_Click" Visibility="{Binding Uncertain, Converter={StaticResource Visible}}" IsEnabled="{Binding CanRetry}" Margin="0,0,10,8"/><Button Content="Zamknij" Click="Close_Click" Margin="0,0,10,8"/><Button x:Name="SaveShiftReport" Content="Zapisz szkic" Click="Save_Click" IsEnabled="{Binding CanSave}" Margin="0,0,10,8"/><Button x:Name="FinalizeShiftReport" Content="{Binding FinalizeLabel}" Click="Finalize_Click" IsEnabled="{Binding CanFinalize}" Margin="0,0,10,8"/><Button x:Name="CorrectShiftReport" Content="Zatwierdź korektę" Visibility="{Binding Correction, Converter={StaticResource Visible}}" Click="Correct_Click" IsEnabled="{Binding CanCorrect}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,8"/></WrapPanel>
  </Grid>
</Window>
