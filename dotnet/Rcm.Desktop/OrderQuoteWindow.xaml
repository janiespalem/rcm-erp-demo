<Window x:Class="Rcm.Desktop.OrderQuoteWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource WindowStyle}" Title="Wycena zlecenia" Width="980" Height="820" MinWidth="740" MinHeight="500" WindowStartupLocation="CenterOwner">
  <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock x:Name="Heading" Style="{StaticResource Title}" Margin="0,0,0,18"/>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <Button Content="Wczytaj wycenę ponownie" Click="Reload_Click" Visibility="{Binding CanLoad, Converter={StaticResource Visible}}" HorizontalAlignment="Left" Margin="0,0,0,12"/>
        <StackPanel IsEnabled="{Binding CanEdit}">
          <TextBlock Text="Metoda wyceny"/><ComboBox x:Name="Methods" SelectedValue="{Binding Method}" SelectedValuePath="Key" DisplayMemberPath="Value" Margin="0,6,0,16"/>
          <StackPanel Visibility="{Binding IsManual, Converter={StaticResource Visible}}"><TextBlock Text="Cena netto (PLN)"/><TextBox Text="{Binding ManualTotal, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,16"/></StackPanel>
          <StackPanel Visibility="{Binding IsStructured, Converter={StaticResource Visible}}">
            <TextBlock Text="Operacje" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
            <DataGrid MinRowHeight="38" GridLinesVisibility="Horizontal" x:Name="Processes" ItemsSource="{Binding Processes}" AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False" MinHeight="95" MaxHeight="230" ScrollViewer.HorizontalScrollBarVisibility="Auto">
              <DataGrid.Columns>
                <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Operacja" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*" MinWidth="150"/>
                <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Wydział" Binding="{Binding Department, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Godziny" Binding="{Binding Hours, UpdateSourceTrigger=PropertyChanged}" Width="85"/>
                <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="PLN/h" Binding="{Binding Rate, UpdateSourceTrigger=PropertyChanged}" Width="85"/>
                <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Koszt stały" Binding="{Binding Cost, UpdateSourceTrigger=PropertyChanged}" Width="105"/>
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="Koszt stały jest używany tylko przy pustych godzinach i stawce." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,8"/>
            <WrapPanel><ComboBox x:Name="OperationCatalog" DisplayMemberPath="Name" Width="240" Margin="0,0,8,8"/><Button Content="Dodaj operację" Click="AddProcess_Click" Margin="0,0,8,8"/><Button Content="Usuń operację" Click="RemoveProcess_Click" Margin="0,0,0,8"/></WrapPanel>
            <TextBlock Text="Materiały" Style="{StaticResource SectionTitle}" Margin="0,18,0,10"/>
            <DataGrid MinRowHeight="38" GridLinesVisibility="Horizontal" x:Name="Materials" ItemsSource="{Binding Materials}" AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False" MinHeight="95" MaxHeight="230">
              <DataGrid.Columns><DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Materiał" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/><DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="kg" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="95"/><DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="PLN/kg" Binding="{Binding Price, UpdateSourceTrigger=PropertyChanged}" Width="95"/><DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Koszt stały" Binding="{Binding Cost, UpdateSourceTrigger=PropertyChanged}" Width="110"/></DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="Dodatni koszt stały materiału zastępuje ilość × cenę." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,8"/>
            <WrapPanel><ComboBox x:Name="MaterialCatalog" DisplayMemberPath="Name" Width="240" Margin="0,0,8,8"/><Button Content="Dodaj materiał" Click="AddMaterial_Click" Margin="0,0,8,8"/><Button Content="Usuń materiał" Click="RemoveMaterial_Click" Margin="0,0,0,8"/></WrapPanel>
            <UniformGrid Columns="2" Margin="0,16,0,0">
              <StackPanel Margin="0,0,16,14"><TextBlock Text="Dodatkowa robocizna (h)"/><TextBox Text="{Binding LaborHours, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/></StackPanel>
              <StackPanel Margin="0,0,0,14"><TextBlock Text="Transport (PLN)"/><TextBox Text="{Binding Transport, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/></StackPanel>
              <StackPanel Margin="0,0,16,14"><TextBlock Text="Koszty ogólne (%)"/><TextBox Text="{Binding Overhead, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/></StackPanel>
              <StackPanel Margin="0,0,0,14"><TextBlock Text="Marża (%)"/><TextBox Text="{Binding Margin, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/></StackPanel>
              <StackPanel Margin="0,0,16,14"><TextBlock Text="Masa netto (kg)"/><TextBox Text="{Binding WeightNet, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/></StackPanel>
              <StackPanel Margin="0,0,0,14"><TextBlock Text="Stawka od masy (PLN/kg)"/><TextBox Text="{Binding WeightRate, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/></StackPanel>
            </UniformGrid>
            <Expander Header="Masy i koszt materiału bez pozycji">
              <UniformGrid Columns="2" Margin="0,14,0,0">
                <StackPanel Margin="0,0,16,14"><TextBlock Text="Masa netto (kg)"/><TextBox Text="{Binding WeightNet, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                <StackPanel Margin="0,0,0,14"><TextBlock Text="Masa brutto (kg)"/><TextBox Text="{Binding WeightGross, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                <StackPanel Margin="0,0,16,14"><TextBlock Text="Masa materiału (kg)"/><TextBox Text="{Binding MaterialWeight, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                <StackPanel Margin="0,0,0,14"><TextBlock Text="Cena materiału (PLN/kg)"/><TextBox Text="{Binding MaterialPrice, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                <StackPanel Margin="0,0,16,14"><TextBlock Text="Koszt materiału (PLN)"/><TextBox Text="{Binding MaterialCost, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                <StackPanel Margin="0,0,0,14"><TextBlock Text="Podstawa masy"/><ComboBox x:Name="WeightBases" SelectedValue="{Binding WeightBasis}" SelectedValuePath="Key" DisplayMemberPath="Value"/></StackPanel>
              </UniformGrid>
            </Expander>
            <CheckBox Content="Pokaż ceny jednostkowe" IsChecked="{Binding ShowUnitPrices}" Margin="0,12,0,14"/>
          </StackPanel>
        </StackPanel>
        <Border Style="{StaticResource Card}" Padding="18" Margin="0,14"><TextBlock Text="{Binding Result}" FontSize="18" TextWrapping="Wrap"/></Border>
        <StackPanel Visibility="{Binding Uncertain, Converter={StaticResource Visible}}">
          <Button Content="Sprawdź zapisaną wycenę" Click="Verify_Click" HorizontalAlignment="Left"/>
          <TextBlock Text="{Binding Comparison}" TextWrapping="Wrap" Margin="0,12"/>
          <Button Content="Porównano — odblokuj zapis" Click="Accept_Click" IsEnabled="{Binding CanAcceptVerified}" HorizontalAlignment="Left"/>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
    <Grid Grid.Row="2" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,14,0" AutomationProperties.LiveSetting="Polite"/>
      <WrapPanel Grid.Column="1"><Button Content="Zamknij" Click="Close_Click" Margin="0,0,8,0"/><Button Content="Oblicz" Click="Preview_Click" IsEnabled="{Binding CanEdit}" Margin="0,0,8,0"/><Button x:Name="Save" Content="Zapisz wycenę" Style="{StaticResource PrimaryButton}" Click="Save_Click" IsEnabled="{Binding CanSave}"/></WrapPanel>
    </Grid>
  </Grid>
</Window>
