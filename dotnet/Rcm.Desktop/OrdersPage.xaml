<UserControl x:Class="Rcm.Desktop.OrdersPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="{StaticResource PageMargin}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,20">
      <Button DockPanel.Dock="Right" Content="+ Nowe zlecenie" Click="Create_Click" Style="{StaticResource PrimaryButton}" Visibility="{Binding CanCreate, Converter={StaticResource Visible}}" AutomationProperties.AutomationId="CreateOrder"/>
      <StackPanel><TextBlock Text="Zlecenia" Style="{StaticResource Title}"/></StackPanel>
    </DockPanel>
    <Grid Grid.Row="1" Visibility="{Binding ListVisible, Converter={StaticResource Visible}}">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="220"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBox x:Name="Search" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" TextChanged="Search_Changed" ToolTip="Szukaj po numerze, kliencie lub opisie" VerticalContentAlignment="Center"/>
        <ComboBox x:Name="StatusFilter" Grid.Column="2" SelectedValue="{Binding Filter}" SelectedValuePath="Key" DisplayMemberPath="Value" SelectionChanged="Filter_Changed"/>
        <CheckBox Grid.Column="3" Content="Archiwum" IsChecked="{Binding Archived}" Checked="Archive_Changed" Unchecked="Archive_Changed" VerticalAlignment="Center" Margin="14,0,0,0"/>
      </Grid>
      <Border Grid.Row="1" Style="{StaticResource Card}">
        <DataGrid MinRowHeight="42" GridLinesVisibility="Horizontal" x:Name="Orders" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" MouseDoubleClick="Open_Click" KeyDown="Orders_KeyDown" EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.HorizontalScrollBarVisibility="Auto">
          <DataGrid.Columns>
            <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Numer" Binding="{Binding Number}" Width="110"/>
            <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Pytania" Binding="{Binding PendingQuestions}" Width="80"/>
            <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Klient" Binding="{Binding Client}" Width="1.3*" MinWidth="140"/>
            <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Opis" Binding="{Binding Description}" Width="2*" MinWidth="180"/>
            <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Stan" Binding="{Binding Status}" Width="170"/>
            <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Termin" Binding="{Binding Deadline}" Width="115"/>
          </DataGrid.Columns>
        </DataGrid>
      </Border>
      <DockPanel Grid.Row="2" Margin="0,12,0,0">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Poprzednia" Click="Previous_Click" Margin="0,0,8,0"/><Button Content="Następna" Click="Next_Click"/></StackPanel>
        <Button Content="Otwórz zlecenie" Click="Open_Click" DockPanel.Dock="Left" Margin="0,0,16,0"/>
        <TextBlock Text="{Binding PageInfo}" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
      </DockPanel>
    </Grid>
    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="22" Visibility="{Binding DetailVisible, Converter={StaticResource Visible}}">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <WrapPanel><Button Content="← Wróć do listy" Click="Back_Click" Margin="0,0,12,12"/><Button Content="Edytuj dane" Click="Edit_Click" IsEnabled="{Binding CanEdit}" Margin="0,0,12,12"/><Button Content="Sprawdź i skieruj zlecenie" Click="Triage_Click" IsEnabled="{Binding CanTriage}" Margin="0,0,12,12"/><Button Content="Wycena" Click="Quote_Click" IsEnabled="{Binding CanQuote}" Margin="0,0,0,12"/></WrapPanel>
        <WrapPanel Margin="0,0,0,10">
          <Button Content="Operacje i pytania" Click="Resources_Click" Visibility="{Binding SupportsResources, Converter={StaticResource Visible}}" IsEnabled="{Binding CanResources}" Margin="0,0,8,0"/>
          <Button Content="Załączniki" Click="Attachments_Click" Visibility="{Binding SupportsAttachments, Converter={StaticResource Visible}}" IsEnabled="{Binding CanAttachments}" Margin="0,0,8,8"/>
          <Button Content="Dokumenty" Click="Documents_Click" Visibility="{Binding SupportsDocuments, Converter={StaticResource Visible}}" IsEnabled="{Binding CanDocuments}" Margin="0,0,8,8" AutomationProperties.AutomationId="OrderDocuments"/>
          <Button Content="Zapisz jako szablon" Click="SaveTemplate_Click" Visibility="{Binding CanSaveTemplate, Converter={StaticResource Visible}}" Margin="0,0,8,8" AutomationProperties.AutomationId="SaveOrderTemplate"/>
        </WrapPanel>
          <TextBlock Text="{Binding Heading}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,6"/>
          <TextBlock Text="{Binding DetailStatus}" Foreground="{StaticResource Green}" FontWeight="SemiBold" Margin="0,0,0,18"/>
          <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="15" LineHeight="23" Margin="0,0,0,20"/>
          <TextBlock Text="{Binding Details}" TextWrapping="Wrap" LineHeight="23"/>
          <WrapPanel Margin="0,20,0,12">
            <Button Content="Zatwierdź wycenę" Tag="confirm" Click="Transition_Click" Visibility="{Binding CanConfirm, Converter={StaticResource Visible}}" Margin="0,0,10,10"/>
            <Button Content="{Binding DeliveryAction}" Tag="deliver" Click="Transition_Click" Visibility="{Binding CanDeliver, Converter={StaticResource Visible}}" Margin="0,0,10,10"/>
            <Button Content="Archiwizuj" Tag="archive" Click="Transition_Click" Visibility="{Binding CanArchive, Converter={StaticResource Visible}}" Margin="0,0,10,10"/>
            <Button Content="Przywróć" Tag="restore" Click="Transition_Click" Visibility="{Binding CanRestore, Converter={StaticResource Visible}}" Margin="0,0,10,10"/>
          </WrapPanel>
          <TextBlock Text="Historia zlecenia" Style="{StaticResource SectionTitle}" Margin="0,12,0,12"/>
          <ItemsControl ItemsSource="{Binding History}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource Line}" BorderThickness="2,0,0,0" Padding="14,4" Margin="0,0,0,14"><TextBlock Text="{Binding}" TextWrapping="Wrap" LineHeight="21"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Border>
    <DockPanel Grid.Row="2" Margin="0,12,0,0"><Button Content="Odśwież" Click="Refresh_Click" DockPanel.Dock="Right" Margin="12,0,0,0"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/></DockPanel>
  </Grid>
</UserControl>
