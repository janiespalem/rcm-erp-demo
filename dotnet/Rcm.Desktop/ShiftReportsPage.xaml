<UserControl x:Class="Rcm.Desktop.ShiftReportsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Rcm.Desktop">
  <Grid Margin="{StaticResource PageMargin}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="Raporty zmianowe" Style="{StaticResource Title}" Margin="0,0,0,12"/>
    <Expander x:Name="DailySummary" Grid.Row="1" Header="Podsumowanie dnia" Margin="0,0,0,10"><Border Style="{StaticResource Card}" Padding="12,8"><StackPanel><TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontWeight="SemiBold" ToolTip="Podsumowanie obejmuje aktualne wersje zakończonych i skorygowanych raportów. Szkice i usunięte raporty są pomijane." Margin="0,0,0,6"/><ItemsControl ItemsSource="{Binding Today}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding DailyLabel}" Tag="{Binding Report.Id}" Click="Today_Click" Margin="0,0,12,8" ToolTip="{Binding State}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></Expander>
    <WrapPanel Grid.Row="2" Margin="0,0,0,10">
      <StackPanel Margin="0,0,12,0"><TextBlock Text="Dzień raportu" Style="{StaticResource Label}"/><DatePicker x:Name="ShiftReportDay" SelectedDate="{Binding EntryDate}" Width="160" Margin="0,6,0,0" IsEnabled="{Binding CanOpenDate}" AutomationProperties.Name="Dzień raportu"/></StackPanel>
      <StackPanel Margin="0,0,16,0"><TextBlock Text="Zmiana" Style="{StaticResource Label}"/><ComboBox x:Name="ShiftReportShift" SelectedItem="{Binding EntryShift}" Width="90" Margin="0,6,0,0" IsEnabled="{Binding CanOpenDate}" AutomationProperties.Name="Zmiana raportu"><ComboBox.ItemsSource><x:Static Member="local:ShiftReportsChoices.Shifts"/></ComboBox.ItemsSource></ComboBox></StackPanel>
      <Button x:Name="OpenShiftDate" Content="Otwórz raport zmiany" Click="OpenDate_Click" IsEnabled="{Binding CanOpenDate}" VerticalAlignment="Bottom" ToolTip="Otwiera raport wybranego dnia i zmiany. Jeśli go nie ma, rozpoczyna nowy raport."/>
    </WrapPanel>
    <Expander x:Name="ReportFilters" Grid.Row="3" Header="Filtry listy" Margin="0,0,0,10"><WrapPanel Margin="0,8,0,0"><StackPanel Margin="0,0,12,0"><TextBlock Text="Od daty" Style="{StaticResource Label}"/><DatePicker SelectedDate="{Binding DateFrom}" SelectedDateChanged="Filter_Changed" Width="150" Margin="0,6,0,0"/></StackPanel><StackPanel Margin="0,0,12,0"><TextBlock Text="Do daty" Style="{StaticResource Label}"/><DatePicker SelectedDate="{Binding DateTo}" SelectedDateChanged="Filter_Changed" Width="150" Margin="0,6,0,0"/></StackPanel><StackPanel Margin="0,0,16,0"><TextBlock Text="Zmiana" Style="{StaticResource Label}"/><ComboBox SelectedItem="{Binding ShiftFilter}" SelectionChanged="Shift_Changed" Width="100" Margin="0,6,0,0"><ComboBox.ItemsSource><x:Static Member="local:ShiftReportsChoices.Filters"/></ComboBox.ItemsSource></ComboBox></StackPanel><CheckBox Content="Usunięte" IsChecked="{Binding Deleted}" Checked="Deleted_Changed" Unchecked="Deleted_Changed" Visibility="{Binding CanSeeDeleted, Converter={StaticResource Visible}}" VerticalAlignment="Bottom" Margin="0,0,0,10"/></WrapPanel></Expander>
    <Border Grid.Row="4" Style="{StaticResource Card}"><DataGrid x:Name="ShiftReportRows" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserSortColumns="True" SelectionMode="Single" SelectionUnit="FullRow" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.HorizontalScrollBarVisibility="Auto" MinRowHeight="44" MouseDoubleClick="Open_Click" KeyDown="Rows_KeyDown"><DataGrid.Columns><DataGridTextColumn Header="Data" Binding="{Binding Date}" Width="115"/><DataGridTextColumn Header="Zmiana" Binding="{Binding Shift}" Width="80"/><DataGridTextColumn Header="Autor" Binding="{Binding Author}" Width="*" MinWidth="160" ElementStyle="{StaticResource CellText}"/><DataGridTextColumn Header="Status" Binding="{Binding State}" Width="130"/><DataGridTextColumn Header="Zalane / uszkodzone" Binding="{Binding Quantity}" Width="175"/><DataGridTextColumn Header="Uwagi" Binding="{Binding Warning}" Width="150"/></DataGrid.Columns></DataGrid></Border>
    <StackPanel Grid.Row="5" Margin="0,12,0,0"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Poprzednia" Click="Previous_Click" IsEnabled="{Binding CanPrevious}" Margin="0,0,8,0"/><Button Content="Następna" Click="Next_Click" IsEnabled="{Binding CanNext}" Margin="0,0,8,0"/><Button Content="Odśwież" Click="Refresh_Click"/></StackPanel><Button x:Name="OpenShiftReport" Content="Otwórz raport" Click="Open_Click" IsEnabled="{Binding CanOpen}" DockPanel.Dock="Left" Margin="0,0,16,0"/><TextBlock Text="{Binding PageInfo}" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></DockPanel><TextBlock Text="{Binding AccessHint}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,4"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/></StackPanel>
  </Grid>
</UserControl>
