<Window x:Class="Rcm.Desktop.StartupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="FactoryFlow — uruchamianie" Style="{StaticResource WindowStyle}" Width="520" Height="300" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
  <Grid Margin="36"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
    <TextBlock Text="FactoryFlow" FontSize="34" FontWeight="Bold" Foreground="#285746"/>
    <TextBlock x:Name="Status" Grid.Row="1" Text="Uruchamianie demo…" Margin="0,20,0,18" TextWrapping="Wrap"/>
    <ProgressBar x:Name="Progress" Grid.Row="2" Height="5" IsIndeterminate="True"/>
    <Button x:Name="SkipUpdate" Grid.Row="3" Content="Uruchom bez aktualizacji" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="Skip_Click"/>
  </Grid>
</Window>
