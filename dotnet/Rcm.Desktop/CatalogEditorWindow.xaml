<Window x:Class="Rcm.Desktop.CatalogEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource WindowStyle}" Title="Pozycja katalogu" Width="760" Height="740" MinWidth="580" MinHeight="480" WindowStartupLocation="CenterOwner">
  <Grid Margin="26">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="{Binding Heading}" Style="{StaticResource Title}" TextWrapping="Wrap" Margin="0,0,0,18"/>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <Border Style="{StaticResource Card}" Padding="18" Visibility="{Binding IsRemoval, Converter={StaticResource Visible}}">
          <StackPanel><TextBlock Text="{Binding Name}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding RemovalHint}" TextWrapping="Wrap" LineHeight="22" Margin="0,12,0,0"/></StackPanel>
        </Border>
        <StackPanel Visibility="{Binding IsForm, Converter={StaticResource Visible}}">
          <TextBlock Text="Nazwa / wymiar *" Style="{StaticResource Label}"/>
          <TextBox x:Name="CatalogName" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" Margin="0,6,0,3" AutomationProperties.Name="Nazwa pozycji katalogu"/>
          <TextBlock Text="{Binding NameError}" Foreground="{StaticResource Error}" TextWrapping="Wrap"/>
          <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="{Binding GroupLabel}" Style="{StaticResource Label}"/><TextBox Text="{Binding Group, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" Margin="0,6,0,3"/><TextBlock Text="{Binding GroupError}" Foreground="{StaticResource Error}" TextWrapping="Wrap"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="{Binding RateLabel}" Style="{StaticResource Label}"/><TextBox x:Name="CatalogRate" Text="{Binding Rate, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" Margin="0,6,0,3"/><TextBlock Text="{Binding RateError}" Foreground="{StaticResource Error}" TextWrapping="Wrap"/></StackPanel>
          </Grid>
          <StackPanel Visibility="{Binding IsMaterials, Converter={StaticResource Visible}}" Margin="0,16,0,0">
            <TextBlock Text="Uwagi" Style="{StaticResource Label}"/>
            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="95" MaxHeight="180" VerticalScrollBarVisibility="Auto" Margin="0,6,0,12"/>
            <CheckBox Content="Aktywny materiał" IsChecked="{Binding Active}" IsEnabled="{Binding CanEdit}"/>
          </StackPanel>
          <StackPanel Visibility="{Binding IsOperations, Converter={StaticResource Visible}}" Margin="0,16,0,0">
            <TextBlock Text="Słowa do podpowiedzi" Style="{StaticResource Label}"/>
            <TextBox Text="{Binding Formula, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" TextWrapping="Wrap" MinHeight="75" Margin="0,6,0,8"/>
            <TextBlock Text="Pozostaw puste, aby dobrać słowa na podstawie nazwy i wydziału. Są używane do podpowiadania operacji przy wycenie." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
          </StackPanel>
        </StackPanel>
        <ItemsControl ItemsSource="{Binding Errors}" Margin="0,14,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="{StaticResource Error}" TextWrapping="Wrap"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <TextBlock Text="{Binding Comparison}" TextWrapping="Wrap" LineHeight="22" Margin="0,18,0,0"/>
        <Button Content="Użyj aktualnej wersji i zachowaj mój formularz" Click="Accept_Click" IsEnabled="{Binding CanAccept}" Visibility="{Binding HasConflict, Converter={StaticResource Visible}}" HorizontalAlignment="Left" Margin="0,14,0,0"/>
      </StackPanel>
    </ScrollViewer>
    <TextBlock Grid.Row="2" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,16,0,12" AutomationProperties.LiveSetting="Polite"/>
    <DockPanel Grid.Row="3">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Zamknij" Click="Close_Click" Margin="0,0,10,0"/><Button x:Name="SaveCatalog" Content="{Binding SaveLabel}" Click="Save_Click" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding CanSave}" AutomationProperties.AutomationId="SaveCatalogEntry"/></StackPanel>
      <Button Content="Porównaj" Click="Compare_Click" IsEnabled="{Binding CanCompare}" Visibility="{Binding HasConflict, Converter={StaticResource Visible}}" HorizontalAlignment="Left"/>
    </DockPanel>
  </Grid>
</Window>
