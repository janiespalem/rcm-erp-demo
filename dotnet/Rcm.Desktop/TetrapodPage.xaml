<UserControl x:Class="Rcm.Desktop.TetrapodPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Language="pl-PL">
  <Grid Margin="0,0,0,4">
    <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="0,0,12,0">
        <TextBlock Text="Tetrapod" Style="{StaticResource Title}" Margin="0,0,0,14"/>
        <Border Style="{StaticResource Card}" Padding="20">
          <StackPanel IsEnabled="{Binding CanEdit}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="Plan tetrapodów (szt.)" Style="{StaticResource Label}"/><TextBox x:Name="Planned" Text="{Binding Planned, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Plan tetrapodów" AutomationProperties.AutomationId="TetrapodPlanned"/></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="Wykonano (szt.)" Style="{StaticResource Label}"/><TextBox x:Name="Completed" Text="{Binding Completed, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Wykonano tetrapodów"/></StackPanel>
            </Grid>
            <CheckBox Content="Bilans z sumy lokalnej historii dostaw" IsChecked="{Binding UseHistory}" Margin="0,16,0,0"/>
            <TextBlock Text="Ręczny bilans według średnicy (kg) — opcjonalnie" Style="{StaticResource Label}"/>
            <TextBlock Text="Ręczne wartości obowiązują po wyłączeniu sumy historii. Puste pole oznacza brak danych." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,8"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="Ø6 mm"/><TextBox x:Name="Delivery6" Text="{Binding Delivery6, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Dostawa średnica 6 milimetrów w kilogramach"/></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="Ø12 mm"/><TextBox Text="{Binding Delivery12, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Dostawa średnica 12 milimetrów w kilogramach"/></StackPanel>
              <StackPanel Grid.Column="4"><TextBlock Text="Ø16 mm"/><TextBox Text="{Binding Delivery16, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Dostawa średnica 16 milimetrów w kilogramach"/></StackPanel>
            </Grid>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Padding="16" Margin="0,16,0,0">
          <StackPanel>
            <TextBlock Text="Dostawy stali · historia lokalna" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="Zapis na tym komputerze dla Twojego konta. Dodanie i usunięcie wymagają zapisania historii." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,5,0,10"/>
            <Grid IsEnabled="{Binding CanManageDeliveries}">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="Ø6 (kg)"/><TextBox x:Name="NewDelivery6" Text="{Binding NewDelivery6, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nowa dostawa Ø6 w kilogramach"/></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="Ø12 (kg)"/><TextBox x:Name="NewDelivery12" Text="{Binding NewDelivery12, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nowa dostawa Ø12 w kilogramach"/></StackPanel>
              <StackPanel Grid.Column="4"><TextBlock Text="Ø16 (kg)"/><TextBox x:Name="NewDelivery16" Text="{Binding NewDelivery16, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nowa dostawa Ø16 w kilogramach"/></StackPanel>
              <Button x:Name="AddDelivery" Grid.Column="5" Content="Dodaj dostawę" Click="AddDelivery_Click" VerticalAlignment="Bottom" Margin="12,0,0,0"/>
            </Grid>
            <DataGrid x:Name="DeliveryHistory" ItemsSource="{Binding Deliveries}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="240" RowHeight="42" Margin="0,12,0,8" EnableRowVirtualization="True" EnableColumnVirtualization="True" AutomationProperties.Name="Lokalna historia dostaw stali">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Data" Binding="{Binding Date}" Width="100"/>
                <DataGridTextColumn Header="Dzień tygodnia" Binding="{Binding Weekday}" Width="120"/>
                <DataGridTextColumn Header="Godzina" Binding="{Binding Time}" Width="80"/>
                <DataGridTextColumn Header="Ø6 (kg)" Binding="{Binding Entry.Kg6, StringFormat=N3}" Width="100"/>
                <DataGridTextColumn Header="Ø12 (kg)" Binding="{Binding Entry.Kg12, StringFormat=N3}" Width="100"/>
                <DataGridTextColumn Header="Ø16 (kg)" Binding="{Binding Entry.Kg16, StringFormat=N3}" Width="100"/>
                <DataGridTemplateColumn Header="" Width="90"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Usuń" Click="RemoveDelivery_Click" IsEnabled="{Binding DataContext.CanManageDeliveries, RelativeSource={RelativeSource AncestorType=DataGrid}}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="{Binding DeliveryTotals}" TextWrapping="Wrap" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding DeliveryStatus}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,8,0,8" AutomationProperties.LiveSetting="Polite"/>
            <WrapPanel>
              <Button x:Name="SaveHistory" Content="Zapisz historię" Click="SaveHistory_Click" IsEnabled="{Binding CanSaveDeliveries}" Style="{StaticResource PrimaryButton}"/>
              <Button x:Name="RetryHistory" Content="Ponów wczytanie historii" Click="LoadHistory_Click" IsEnabled="{Binding CanReadDeliveries}" Margin="12,0,0,0"/>
            </WrapPanel>
          </StackPanel>
        </Border>
        <StackPanel Visibility="{Binding HasResult, Converter={StaticResource Visible}}" Margin="0,20,0,0">
          <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" Margin="0,0,0,12"/>
          <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,16">
            <UniformGrid Columns="3">
              <StackPanel><TextBlock Text="PLAN" Style="{StaticResource Label}"/><TextBlock Text="{Binding Result.Tetrapods.Planned, StringFormat={}{0:N0} tetrapodów}" Margin="0,8,0,0"/><TextBlock Text="{Binding Result.Baskets.Planned, StringFormat={}{0:N0} koszy}"/><TextBlock Text="{Binding Result.WeightsKg.Planned, StringFormat={}{0:N3} kg}"/></StackPanel>
              <StackPanel><TextBlock Text="WYKONANO" Style="{StaticResource Label}"/><TextBlock Text="{Binding Result.Tetrapods.Completed, StringFormat={}{0:N0} tetrapodów}" Margin="0,8,0,0"/><TextBlock Text="{Binding Result.Baskets.Completed, StringFormat={}{0:N0} koszy}"/><TextBlock Text="{Binding Result.WeightsKg.Completed, StringFormat={}{0:N3} kg}"/></StackPanel>
              <StackPanel><TextBlock Text="POZOSTAŁO" Style="{StaticResource Label}"/><TextBlock Text="{Binding Result.Tetrapods.Remaining, StringFormat={}{0:N0} tetrapodów}" Margin="0,8,0,0"/><TextBlock Text="{Binding Result.Baskets.Remaining, StringFormat={}{0:N0} koszy}"/><TextBlock Text="{Binding Result.WeightsKg.Remaining, StringFormat={}{0:N3} kg}"/></StackPanel>
            </UniformGrid>
          </Border>
          <TabControl Height="300">
            <TabItem Header="Elementy (szt.)">
              <DataGrid ItemsSource="{Binding Result.Parts}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeight="38" AutomationProperties.Name="Liczby elementów zbrojenia">
                <DataGrid.Columns>
                  <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Element" Binding="{Binding Name}" Width="150"/>
                  <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Ø (mm)" Binding="{Binding DiameterMm}" Width="85"/>
                  <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Długość (mm)" Binding="{Binding LengthMm}" Width="110"/>
                  <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Wymiary" Binding="{Binding Dimensions, TargetNullValue=—}" Width="100"/>
                  <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Na kosz" Binding="{Binding Quantities.PerBasket}" Width="85"/>
                  <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Na tetrapod" Binding="{Binding Quantities.PerTetrapod}" Width="105"/>
                  <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Plan" Binding="{Binding Quantities.Planned, StringFormat=N0}" Width="95"/>
                  <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Wykonano" Binding="{Binding Quantities.Completed, StringFormat=N0}" Width="105"/>
                  <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Pozostało" Binding="{Binding Quantities.Remaining, StringFormat=N0}" Width="105"/>
                </DataGrid.Columns>
              </DataGrid>
            </TabItem>
            <TabItem Header="Masy (kg)">
              <DataGrid ItemsSource="{Binding Result.Parts}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeight="38" AutomationProperties.Name="Masy elementów zbrojenia">
                <DataGrid.Columns>
                  <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Element" Binding="{Binding Name}" Width="150"/>
                  <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="1 sztuka" Binding="{Binding UnitWeightKg, StringFormat=N3}" Width="110"/>
                  <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Na kosz" Binding="{Binding WeightsKg.PerBasket, StringFormat=N3}" Width="110"/>
                  <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Na tetrapod" Binding="{Binding WeightsKg.PerTetrapod, StringFormat=N3}" Width="110"/>
                  <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Plan" Binding="{Binding WeightsKg.Planned, StringFormat=N3}" Width="110"/>
                  <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Wykonano" Binding="{Binding WeightsKg.Completed, StringFormat=N3}" Width="110"/>
                  <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Pozostało" Binding="{Binding WeightsKg.Remaining, StringFormat=N3}" Width="110"/>
                </DataGrid.Columns>
              </DataGrid>
            </TabItem>
            <TabItem Header="Średnice">
              <DataGrid ItemsSource="{Binding Result.Diameters}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeight="40" AutomationProperties.Name="Zapotrzebowanie według średnic">
                <DataGrid.Columns>
                  <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Ø (mm)" Binding="{Binding DiameterMm}" Width="80"/>
                  <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Plan (szt.)" Binding="{Binding Planned.Quantity, StringFormat=N0}" Width="110"/>
                  <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Plan (m)" Binding="{Binding Planned.LengthM, StringFormat=N2}" Width="110"/>
                  <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Plan (kg)" Binding="{Binding Planned.WeightKg, StringFormat=N3}" Width="110"/>
                  <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Wykonano (szt.)" Binding="{Binding Completed.Quantity, StringFormat=N0}" Width="120"/>
                  <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Wykonano (m)" Binding="{Binding Completed.LengthM, StringFormat=N2}" Width="120"/>
                  <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Wykonano (kg)" Binding="{Binding Completed.WeightKg, StringFormat=N3}" Width="120"/>
                  <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Pozostało (szt.)" Binding="{Binding Remaining.Quantity, StringFormat=N0}" Width="120"/>
                  <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Pozostało (m)" Binding="{Binding Remaining.LengthM, StringFormat=N2}" Width="120"/>
                  <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Pozostało (kg)" Binding="{Binding Remaining.WeightKg, StringFormat=N3}" Width="120"/>
                </DataGrid.Columns>
              </DataGrid>
            </TabItem>
            <TabItem Header="Dostawy (kg)">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                <TextBlock Text="Bilans obliczeniowy, nie stan magazynu. Brak dostawy: —. Saldo ujemne oznacza niedobór względem planu." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="12"/>
                <DataGrid Grid.Row="1" ItemsSource="{Binding Result.Diameters}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeight="40" AutomationProperties.Name="Obliczeniowy bilans dostaw">
                  <DataGrid.Columns>
                    <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Ø (mm)" Binding="{Binding DiameterMm}" Width="80"/>
                    <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Dostawa" Binding="{Binding DeliveryKg, StringFormat=N3, TargetNullValue=—}" Width="130"/>
                    <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Zużycie obliczone" Binding="{Binding ConsumedKg, StringFormat=N3, TargetNullValue=—}" Width="150"/>
                    <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Po wykonaniu" Binding="{Binding AvailableKg, StringFormat=N3, TargetNullValue=—}" Width="150"/>
                    <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Saldo wobec planu" Binding="{Binding BalanceKg, StringFormat=N3, TargetNullValue=—}" Width="160"/>
                  </DataGrid.Columns>
                </DataGrid>
              </Grid>
            </TabItem>
          </TabControl>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="1" Margin="0,16,0,0">
      <TextBlock Text="{Binding Status}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12" AutomationProperties.LiveSetting="Polite"/>
      <DockPanel>
        <Button Content="Zatrzymaj oczekiwanie" Click="Stop_Click" DockPanel.Dock="Right" Visibility="{Binding IsCalculating, Converter={StaticResource Visible}}" Margin="12,0,0,0"/>
        <Button x:Name="Calculate" Content="Oblicz" Click="Calculate_Click" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding CanEdit}" HorizontalAlignment="Left" MinWidth="130" AutomationProperties.AutomationId="CalculateTetrapod"/>
      </DockPanel>
    </StackPanel>
  </Grid>
</UserControl>
