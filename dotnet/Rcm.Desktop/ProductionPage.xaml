<UserControl x:Class="Rcm.Desktop.ProductionPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Rcm.Desktop">
  <Grid Margin="{StaticResource PageMargin}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel><Button x:Name="NewProductionContract" DockPanel.Dock="Right" Content="Nowy kontrakt" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding CanCreate}" Click="Create_Click"/><Button x:Name="RefreshProduction" DockPanel.Dock="Right" Content="Odśwież" Margin="0,0,10,0" Click="Refresh_Click"/><TextBlock Text="Kontrakty i dostawy" Style="{StaticResource Title}"/></DockPanel>
    <TextBlock Grid.Row="1" Text="{Binding AccessHint}" Foreground="{StaticResource Muted}" Margin="0,10,0,16" TextWrapping="Wrap"/>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBox x:Name="ProductionSearch" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" TextChanged="Search_Changed" Margin="0,0,0,10" ToolTip="Szukaj nazwy lub oznaczenia kontraktu" AutomationProperties.Name="Szukaj kontraktu"/>
        <DataGrid x:Name="ProductionContracts" Grid.Row="1" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" SelectionChanged="Selection_Changed" IsReadOnly="True" AutoGenerateColumns="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" SelectionMode="Single" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Kontrakt" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Plan" Binding="{Binding Plan}" Width="65"/><DataGridTextColumn Header="Typ" Binding="{Binding Mode}" Width="90"/></DataGrid.Columns></DataGrid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0"><Button Content="‹" IsEnabled="{Binding CanPrevious}" Click="Previous_Click"/><TextBlock Text="{Binding PageInfo}" VerticalAlignment="Center" Margin="10,0"/><Button Content="›" IsEnabled="{Binding CanNext}" Click="Next_Click"/></StackPanel>
      </Grid>
      <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <Border Style="{StaticResource Card}" Padding="8" Margin="0,0,0,10"><DockPanel>
          <Button x:Name="EditProductionContract" DockPanel.Dock="Right" Content="Otwórz dane" IsEnabled="{Binding CanOpen}" Click="Edit_Click" VerticalAlignment="Top" Margin="8,4,0,0"/>
          <Expander x:Name="ContractSummary" Header="{Binding DetailHeading}" ToolTip="Stan kontraktu i materiału"><ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto"><StackPanel>
          <TextBlock Text="{Binding DetailInfo}" Margin="0,8,0,12" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
          <TextBlock Text="Potencjał materiału — bez rozchodu" FontWeight="SemiBold" FontSize="17"/>
          <TextBlock Text="{Binding Norm}" TextWrapping="Wrap" Margin="0,8,0,0"/>
          <TextBlock Text="{Binding Material}" TextWrapping="Wrap" Margin="0,6,0,0"/>
          <TextBlock Text="{Binding Potential}" FontWeight="SemiBold" FontSize="18" Margin="0,10,0,6"/>
          <TextBlock Text="{Binding PlanMissing}" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" Foreground="#86551A" Margin="0,10,0,0"/>
        </StackPanel></ScrollViewer></Expander></DockPanel></Border>
        <TabControl x:Name="ProductionTabs" Grid.Row="1">
          <TabItem Header="Dostawy stali"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <WrapPanel Margin="0,0,0,10"><Button x:Name="AddSteelDelivery" Content="Dodaj dostawę" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding CanAddDelivery}" Click="AddDelivery_Click"/><Button x:Name="CorrectSteelDelivery" Content="Koryguj z powodem" Margin="10,0,0,0" IsEnabled="{Binding CanCorrectDelivery}" Click="CorrectDelivery_Click"/></WrapPanel>
            <DataGrid x:Name="ProductionDeliveries" Grid.Row="1" ItemsSource="{Binding Deliveries}" SelectedItem="{Binding SelectedDelivery}" IsReadOnly="True" AutoGenerateColumns="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" SelectionMode="Single" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Data" Binding="{Binding Date}" Width="90"/><DataGridTextColumn Header="Ø6" Binding="{Binding Diameter6}" Width="85"/><DataGridTextColumn Header="Ø12" Binding="{Binding Diameter12}" Width="85"/><DataGridTextColumn Header="Ø16" Binding="{Binding Diameter16}" Width="85"/><DataGridTextColumn Header="Okres" Binding="{Binding Period}" Width="170"/><DataGridTextColumn Header="Uwagi" Binding="{Binding Note}" Width="*"/></DataGrid.Columns></DataGrid>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0"><Button Content="‹" IsEnabled="{Binding CanPreviousDelivery}" Click="PreviousDelivery_Click"/><TextBlock Text="{Binding DeliveryPageInfo}" VerticalAlignment="Center" Margin="10,0"/><Button Content="›" IsEnabled="{Binding CanNextDelivery}" Click="NextDelivery_Click"/></StackPanel>
          </Grid></TabItem>
          <TabItem Header="Historia zmian"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Button Content="Wczytaj historię" HorizontalAlignment="Left" Click="Audit_Click" IsEnabled="{Binding CanOpen}" Margin="0,0,0,10"/>
            <DataGrid x:Name="ProductionAudit" Grid.Row="1" ItemsSource="{Binding Audit}" IsReadOnly="True" AutoGenerateColumns="False" EnableRowVirtualization="True" CanUserAddRows="False"><DataGrid.Columns>
              <DataGridTextColumn Header="Czas w Warszawie" Binding="{Binding RecordedAt}" Width="140"/><DataGridTextColumn Header="Autor ID" Binding="{Binding ActorId}" Width="65"/>
              <DataGridTextColumn Header="Operacja" Binding="{Binding Action}" Width="135"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
              <DataGridTextColumn Header="Powód" Binding="{Binding Reason}" Width="*" MinWidth="90"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
              <DataGridTextColumn Header="Zmiany" Binding="{Binding Changes}" Width="2*" MinWidth="180"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
            </DataGrid.Columns></DataGrid>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0"><Button Content="‹" IsEnabled="{Binding CanPreviousAudit}" Click="PreviousAudit_Click"/><TextBlock Text="{Binding AuditPageInfo}" VerticalAlignment="Center" Margin="10,0"/><Button Content="›" IsEnabled="{Binding CanNextAudit}" Click="NextAudit_Click"/></StackPanel>
          </Grid></TabItem>
          <TabItem Header="Raporty kontraktu" Visibility="{Binding Reports.Available, Converter={StaticResource Visible}}"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Expander x:Name="ContractReportsSummary" Header="Przyjęte operacje" Margin="0,0,0,8"><ScrollViewer MaxHeight="90" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="{Binding Reports.Forms}" TextWrapping="Wrap" Margin="0,6,0,4"/><TextBlock Text="{Binding Reports.Products}" TextWrapping="Wrap"/><TextBlock Text="{Binding Reports.Summary}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,6,0,10"/></StackPanel></ScrollViewer></Expander>
            <WrapPanel Grid.Row="1" Margin="0,0,0,10"><ComboBox ItemsSource="{x:Static local:ProductionReportsViewModel.Filters}" DisplayMemberPath="Label" SelectedItem="{Binding Reports.Filter}" IsEnabled="{Binding Reports.CanLoad}" Width="155" Margin="0,0,10,0" AutomationProperties.Name="Stan raportów"/><Button x:Name="LoadContractReports" Content="Wczytaj" Click="Reports_Click" IsEnabled="{Binding Reports.CanLoad}" Margin="0,0,10,0"/><Button x:Name="OpenContractReport" Content="Otwórz raport" Click="OpenContractReport_Click" IsEnabled="{Binding Reports.CanOpenReport}"/></WrapPanel>
            <DataGrid x:Name="ContractReports" Grid.Row="2" ItemsSource="{Binding Reports.Reports}" SelectedItem="{Binding Reports.SelectedReport}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" EnableRowVirtualization="True"><DataGrid.Columns><DataGridTextColumn Header="Data" Binding="{Binding Date}" Width="95"/><DataGridTextColumn Header="Zmiana" Binding="{Binding Shift}" Width="65"/><DataGridTextColumn Header="Autor" Binding="{Binding Author}" Width="*"/><DataGridTextColumn Header="Stan" Binding="{Binding Status}" Width="160"/></DataGrid.Columns></DataGrid>
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0"><Button Content="‹" Click="ReportsPrevious_Click" IsEnabled="{Binding Reports.CanPrevious}"/><TextBlock Text="{Binding Reports.PageInfo}" VerticalAlignment="Center" Margin="10,0"/><Button Content="›" Click="ReportsNext_Click" IsEnabled="{Binding Reports.CanNext}"/></StackPanel>
          </Grid></TabItem>
          <TabItem Header="Do sprawdzenia" Visibility="{Binding Reports.CanReview, Converter={StaticResource Visible}}"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <WrapPanel Margin="0,0,0,10"><Button x:Name="LoadProductionReviewQueue" Content="Odśwież kolejkę" Click="Queue_Click" Margin="0,0,10,0"/><Button x:Name="OpenProductionReview" Content="Otwórz raport" Click="OpenQueueReport_Click" IsEnabled="{Binding Reports.CanOpenQueue}"/></WrapPanel>
            <DataGrid x:Name="ProductionReviewQueue" Grid.Row="1" ItemsSource="{Binding Reports.Queue}" SelectedItem="{Binding Reports.SelectedQueue}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" EnableRowVirtualization="True"><DataGrid.Columns><DataGridTextColumn Header="Data" Binding="{Binding Date}" Width="95"/><DataGridTextColumn Header="Zmiana" Binding="{Binding Shift}" Width="65"/><DataGridTextColumn Header="Kontrakt" Binding="{Binding Contract}" Width="*"/><DataGridTextColumn Header="Autor" Binding="{Binding Author}" Width="*"/></DataGrid.Columns></DataGrid>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0"><Button Content="‹" Click="QueuePrevious_Click" IsEnabled="{Binding Reports.CanPreviousQueue}"/><TextBlock Text="{Binding Reports.QueuePageInfo}" VerticalAlignment="Center" Margin="10,0"/><Button Content="›" Click="QueueNext_Click" IsEnabled="{Binding Reports.CanNextQueue}"/></StackPanel>
          </Grid></TabItem>
        </TabControl>
      </Grid>
    </Grid>
    <TextBlock Grid.Row="3" Text="{Binding Status}" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{StaticResource Muted}" AutomationProperties.LiveSetting="Polite"/>
  </Grid>
</UserControl>
