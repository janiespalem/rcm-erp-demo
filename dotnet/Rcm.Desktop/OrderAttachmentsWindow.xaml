<Window x:Class="Rcm.Desktop.OrderAttachmentsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource WindowStyle}" Title="Załączniki zlecenia" Width="900" Height="720" MinWidth="760" MinHeight="560" WindowStartupLocation="CenterOwner">
  <Grid Margin="26">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock x:Name="Heading" Style="{StaticResource Title}" Margin="0,0,0,8"/>
    <DataGrid x:Name="AttachmentList" Grid.Row="2" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" IsEnabled="{Binding CanReload}"
              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow" AutomationProperties.Name="Załączniki zlecenia">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Nazwa pliku" Binding="{Binding Filename}" Width="*" ElementStyle="{StaticResource CellText}"/>
        <DataGridTextColumn Header="Rozmiar (B)" Binding="{Binding SizeBytes, StringFormat=N0, TargetNullValue=—}" Width="125" ElementStyle="{StaticResource CellText}"/>
        <DataGridTextColumn Header="Dodał" Binding="{Binding UploadedBy, TargetNullValue=—}" Width="160" ElementStyle="{StaticResource CellText}"/>
      </DataGrid.Columns>
    </DataGrid>
    <Border Grid.Row="3" Style="{StaticResource Card}" Padding="16" Margin="0,16,0,0">
      <TextBlock Text="{Binding SelectionDetails}" TextWrapping="Wrap" MaxHeight="100" TextTrimming="CharacterEllipsis"/>
    </Border>
    <Grid Grid.Row="4" Margin="0,16,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBox Text="{Binding UploadPath, Mode=OneWay}" IsReadOnly="True" VerticalAlignment="Center" Margin="0,0,10,0" AutomationProperties.Name="Wybrany plik"/>
      <Button Grid.Column="1" Content="Wybierz plik…" IsEnabled="{Binding CanChooseFile}" Click="Choose_Click" Margin="0,0,8,0"/>
      <Button Grid.Column="2" Content="Dodaj" IsEnabled="{Binding CanUpload}" Click="Upload_Click"/>
    </Grid>
    <Grid Grid.Row="5" Margin="0,18,0,0">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,0,0,12" AutomationProperties.LiveSetting="Polite"/>
      <DockPanel Grid.Row="1">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Zamknij" Click="Close_Click" Margin="0,0,8,0"/><Button x:Name="SaveAttachment" Content="Zapisz plik…" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding CanDownload}" Click="Save_Click"/></StackPanel>
        <StackPanel Orientation="Horizontal"><Button Content="Odśwież" IsEnabled="{Binding CanReload}" Click="Reload_Click" Margin="0,0,8,0"/><Button Content="Usuń" IsEnabled="{Binding CanRemove}" Click="Remove_Click" Margin="0,0,8,0"/><Button Content="Anuluj" IsEnabled="{Binding Busy}" Click="Cancel_Click"/></StackPanel>
      </DockPanel>
    </Grid>
  </Grid>
</Window>
