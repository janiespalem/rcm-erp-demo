<Window x:Class="Rcm.Desktop.OrderEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource WindowStyle}" Title="{Binding Title}" Width="850" Height="780" MinWidth="650" MinHeight="480" WindowStartupLocation="CenterOwner">
  <Grid Margin="26">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="{Binding Title}" Style="{StaticResource Title}" Margin="0,0,0,18"/>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <StackPanel IsEnabled="{Binding CanEdit}">
          <StackPanel Visibility="{Binding IsNew, Converter={StaticResource Visible}}" Margin="0,0,0,12">
            <TextBlock Text="Kategoria" Style="{StaticResource Label}" Margin="0,0,0,8"/>
            <WrapPanel>
              <Button Content="Remont" Tag="remont" Click="Category_Click" Margin="0,0,8,8"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding OrderType}" Value="remont"><Setter Property="Background" Value="{StaticResource Lime}"/><Setter Property="BorderBrush" Value="{StaticResource Green}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
              <Button Content="Nowa część" Tag="nowa_czesc" Click="Category_Click" Margin="0,0,8,8"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding OrderType}" Value="nowa_czesc"><Setter Property="Background" Value="{StaticResource Lime}"/><Setter Property="BorderBrush" Value="{StaticResource Green}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
              <Button Content="Katalog" Tag="catalog" Click="Category_Click" Margin="0,0,8,8"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding OrderType}" Value="catalog"><Setter Property="Background" Value="{StaticResource Lime}"/><Setter Property="BorderBrush" Value="{StaticResource Green}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
              <Button Content="Zbrojenie / MON" Tag="zbrojenie" Click="Category_Click" Margin="0,0,8,8"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding OrderType}" Value="zbrojenie"><Setter Property="Background" Value="{StaticResource Lime}"/><Setter Property="BorderBrush" Value="{StaticResource Green}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
            </WrapPanel>
            <Expander x:Name="InternalFirms" Header="Zlecenie wewnętrzne" Margin="0,4,0,8"><WrapPanel Margin="0,10,0,0">
              <Button Content="Demo Construction" Click="Firm_Click" Margin="0,0,8,8"/><Button Content="Demo Logistics" Click="Firm_Click" Margin="0,0,8,8"/><Button Content="Demo Concrete" Click="Firm_Click" Margin="0,0,8,8"/><Button Content="FactoryFlow" Click="Firm_Click" Margin="0,0,8,8"/>
            </WrapPanel></Expander>
          </StackPanel>
          <TextBlock Text="Klient *"/><TextBox x:Name="ClientName" Text="{Binding Client, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" Margin="0,6,0,2"/>
          <TextBlock Text="{Binding ClientError}" Foreground="{StaticResource Error}" TextWrapping="Wrap"/>
          <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Termin *"/><DatePicker Language="pl-PL" SelectedDateFormat="Short" SelectedDate="{Binding Deadline}" Margin="0,6,0,2"/><TextBlock Text="{Binding DeadlineError}" Foreground="{StaticResource Error}"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="Liczba sztuk *"/><TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,2"/><TextBlock Text="{Binding QuantityError}" Foreground="{StaticResource Error}" TextWrapping="Wrap"/></StackPanel>
          </Grid>
          <TextBlock Text="Opis zlecenia *" Margin="0,14,0,6"/><TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" MaxHeight="180" VerticalScrollBarVisibility="Auto"/>
          <TextBlock Text="{Binding DescriptionError}" Foreground="{StaticResource Error}"/>
          <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Rodzaj"/><ComboBox x:Name="Types" SelectedValue="{Binding OrderType}" SelectedValuePath="Key" DisplayMemberPath="Value" Margin="0,6,0,0"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="Numer (pusty = automatycznie)"/><TextBox Text="{Binding Number, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/></StackPanel>
          </Grid>
          <WrapPanel Margin="0,18,0,0"><CheckBox Content="Zlecenie wewnętrzne" IsChecked="{Binding InternalOrder}" IsEnabled="{Binding IsNew}" Margin="0,0,20,10"/><CheckBox Content="Zbrojenie / MON" IsChecked="{Binding Defence}" Margin="0,0,20,10"/><CheckBox Content="Wymaga wizyty" IsChecked="{Binding RequiresVisit}" Margin="0,0,20,10"/></WrapPanel>
          <TextBlock Text="Materiał" Margin="0,10,0,6"/><TextBox Text="{Binding Material, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBlock Text="Materiał ze słownika (opcjonalnie)" Margin="0,14,0,6"/><ComboBox x:Name="ApprovedMaterials" SelectedValue="{Binding ApprovedMaterialId}" SelectedValuePath="Id" DisplayMemberPath="Name"/>
          <TextBlock Text="Produkt z katalogu (opcjonalnie)" Margin="0,14,0,6"/><ComboBox x:Name="Templates" SelectedValue="{Binding TemplateId}" SelectedValuePath="Id" DisplayMemberPath="Name" IsEnabled="{Binding IsNew}"/>
          <Button Content="Odśwież słowniki" Click="ReloadLookups_Click" HorizontalAlignment="Left" Margin="0,10,0,0"/>
          <StackPanel IsEnabled="{Binding IsNew}" Margin="0,14,0,0">
            <TextBlock Text="Pozycje materiałowe" Margin="0,0,0,6"/>
            <DataGrid x:Name="MaterialRows" ItemsSource="{Binding Materials}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False" MinHeight="80" MaxHeight="180">
              <DataGrid.Columns><DataGridTextColumn Header="Materiał" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/><DataGridTextColumn Header="Ilość (kg)" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="150"/></DataGrid.Columns>
            </DataGrid>
            <WrapPanel Margin="0,8,0,0"><Button Content="Dodaj materiał" Click="AddMaterial_Click" Margin="0,0,8,0"/><Button Content="Usuń pozycję" Click="RemoveMaterial_Click"/></WrapPanel>
          </StackPanel>
          <Expander Header="Wykonanie, kontakt i dodatkowe informacje" Margin="0,22,0,0">
            <StackPanel Margin="0,14,0,0">
              <TextBlock Text="Kontakt / telefon"/><TextBox Text="{Binding Contact, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,14"/>
              <TextBlock Text="Adres dostawy"/><TextBox Text="{Binding DeliveryAddress, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,14"/>
              <TextBlock Text="Masa (kg)"/><TextBox Text="{Binding Weight, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,14"/>
              <TextBlock Text="Wartość szacunkowa (PLN)"/><TextBox Text="{Binding EstimatedValue, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,14"/>
              <TextBlock Text="Numer rysunku"/><TextBox Text="{Binding DrawingNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,14"/>
              <CheckBox Content="Jest rysunek" IsChecked="{Binding HasDrawing}" Margin="0,0,0,14"/>
              <TextBlock Text="Wymiary"/><TextBox Text="{Binding Dimensions, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,14"/>
              <TextBlock Text="SOP"/><TextBox Text="{Binding SopName, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,14"/>
              <TextBlock Text="Przeznaczenie"/><TextBox Text="{Binding Purpose, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,14"/>
              <TextBlock Text="Uwagi"/><TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" MaxHeight="180" VerticalScrollBarVisibility="Auto" Margin="0,6,0,14"/>
            </StackPanel>
          </Expander>
        </StackPanel>
        <ItemsControl ItemsSource="{Binding Errors}" Margin="0,12"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource Error}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <StackPanel Visibility="{Binding HasConflict, Converter={StaticResource Visible}}">
          <Button Content="Porównaj z zapisanymi danymi" Click="Compare_Click" HorizontalAlignment="Left"/>
          <TextBlock Text="{Binding Comparison}" TextWrapping="Wrap" Margin="0,12"/>
          <Button Content="Użyj porównanej wersji" Click="Accept_Click" IsEnabled="{Binding CanAccept}" HorizontalAlignment="Left"/>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
    <Grid Grid.Row="2" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,14,0" AutomationProperties.LiveSetting="Polite"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Anuluj" Click="Cancel_Click" Margin="0,0,8,0"/><Button x:Name="Save" Content="{Binding SaveLabel}" Style="{StaticResource PrimaryButton}" Click="Save_Click" IsEnabled="{Binding CanSave}"/></StackPanel>
    </Grid>
  </Grid>
</Window>
