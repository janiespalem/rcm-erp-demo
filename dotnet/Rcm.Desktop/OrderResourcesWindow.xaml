<Window x:Class="Rcm.Desktop.OrderResourcesWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource WindowStyle}" Title="Operacje i pytania" Width="1020" Height="750" MinWidth="780" MinHeight="500" WindowStartupLocation="CenterOwner">
  <Grid Margin="26">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock x:Name="Heading" Style="{StaticResource Title}" Margin="0,0,0,8"/>
    <TextBlock Grid.Row="1" Text="{Binding AccessHint}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,18"/>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="5*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="4*"/></Grid.ColumnDefinitions>
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <TextBlock Text="Operacje" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
        <DataGrid x:Name="ResourcesOperations" Grid.Row="1" ItemsSource="{Binding Operations}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                  SelectionMode="Single" SelectionUnit="FullRow" IsEnabled="{Binding CanNavigate}" SelectionChanged="Operation_Changed" AutomationProperties.Name="Operacje zlecenia">
          <DataGrid.Columns><DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Operacja" Binding="{Binding Name}" Width="*"/><DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Dział" Binding="{Binding Department}" Width="95"/><DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Czas (h)" Binding="{Binding ActualHours, StringFormat=N2}" Width="85"/></DataGrid.Columns>
        </DataGrid>
        <DockPanel Grid.Row="2" Margin="0,18,0,8">
          <Button x:Name="NewQuestion" Content="Nowe pytanie" DockPanel.Dock="Right" Click="NewQuestion_Click" IsEnabled="{Binding CanAsk}"/>
          <TextBlock Text="Pytania o parametry" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
        </DockPanel>
        <DataGrid x:Name="ResourcesQuestions" Grid.Row="3" ItemsSource="{Binding Questions}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                  SelectionMode="Single" SelectionUnit="FullRow" IsEnabled="{Binding CanNavigate}" SelectionChanged="Question_Changed" AutomationProperties.Name="Pytania o parametry zlecenia">
          <DataGrid.Columns>
            <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Pytanie" Binding="{Binding QuestionText}" Width="*"/>
            <DataGridTemplateColumn Header="Stan" Width="100"><DataGridTemplateColumn.CellTemplate><DataTemplate>
              <TextBlock><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource CellText}"><Setter Property="Text" Value="Odpowiedziano"/><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="pending"><Setter Property="Text" Value="Oczekuje"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap" Margin="0,0,0,14"/>
            <TextBlock Text="{Binding Context}" TextWrapping="Wrap" Margin="0,0,0,18"/>
            <StackPanel Visibility="{Binding HasEditor, Converter={StaticResource Visible}}">
              <Label Content="{Binding DraftLabel}" Target="{Binding ElementName=ResourceDraft}" Padding="0" Margin="0,0,0,6"/>
              <TextBox x:Name="ResourceDraft" Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding ReadOnly}"
                       AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" MaxHeight="240" VerticalScrollBarVisibility="Auto" MaxLength="2000"
                       AutomationProperties.Name="{Binding DraftLabel}"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
    <Grid Grid.Row="3" Margin="0,18,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><Button Content="Odśwież dane" Click="Reload_Click" IsEnabled="{Binding CanReload}" HorizontalAlignment="Left"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8,16,0" AutomationProperties.LiveSetting="Polite"/></StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom"><Button Content="Zamknij" Click="Close_Click" Margin="0,0,8,0"/><Button x:Name="SaveResource" Content="{Binding SaveLabel}" Style="{StaticResource PrimaryButton}" Click="Save_Click" IsEnabled="{Binding CanSave}"/></StackPanel>
    </Grid>
  </Grid>
</Window>
